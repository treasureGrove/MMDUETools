#include "/Engine/Private/Common.ush"

StructuredBuffer<float4> LightData;
RWTexture2D<float4> OutputTexture;

// light_data 前 64 项 = 16 盏灯（每灯 4 texel，写第 0 行）；
// 后 18 项 = 四级联相机基 + 主相机位置/前向（写第 1 行 x=0..17）。
[numthreads(64, 1, 1)]
void WriteCS(uint3 d_tid : SV_DispatchThreadID)
{
	if (d_tid.x >= 82)
	{
		return;
	}

    if (d_tid.x < 64)
    {
        OutputTexture[uint2(d_tid.x, 0)] = LightData[d_tid.x];
    }
    else
    {
        OutputTexture[uint2(d_tid.x - 64, 1)] = LightData[d_tid.x];
    }
}
