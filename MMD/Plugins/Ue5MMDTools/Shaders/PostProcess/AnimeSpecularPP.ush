#ifndef MMD_ANIME_SPECULAR_PP_USH
#define MMD_ANIME_SPECULAR_PP_USH

// Anime-Style Specular for Post-Process (二次元风格后处理高光)
// Provides cel-shaded specular highlights for body, hair, and eyes.
// All specular uses smoothstep for hard cel-style edges instead of smooth falloff.
// 为身体、头发和眼睛提供卡通风格硬边高光

struct TAnimeSpecularPP
{
    // Standard cel specular using Blinn-Phong with hard edge (标准卡通高光)
    // Converts smooth Blinn-Phong specular into sharp cel-style highlight
    // 将平滑的Blinn-Phong高光转换为锐利的卡通风格高光
    float3 ComputeAnimeSpec(float3 normal, float3 lightDir, float3 viewDir,
                            float size, float hardness)
    {
        // Half vector for Blinn-Phong (半角向量)
        float3 halfVec = normalize(lightDir + viewDir);
        float NdotH = saturate(dot(normal, halfVec));
        
        // Size controls the specular power (大小控制高光范围)
        // Larger size = broader highlight, smaller = tighter
        float specPower = max(size, 1.0);
        float spec = pow(NdotH, specPower);
        
        // Hardness controls the cel edge sharpness (硬度控制卡通边缘锐度)
        // Higher hardness = sharper transition from dark to bright
        float hardEdge = smoothstep(0.5 - hardness * 0.5, 0.5 + hardness * 0.5, spec);
        
        return float3(hardEdge, hardEdge, hardEdge);
    }

    // Dual-layer Kajiya-Kay anisotropic hair specular (双层Kajiya-Kay各向异性头发高光)
    // Creates the characteristic anime hair highlight ring (天使环)
    // Layer 1: Sharp primary highlight (锐利主高光)
    // Layer 2: Soft secondary highlight (柔和次高光)
    float3 ComputeHairSpec(float3 normal, float3 tangent, float3 lightDir, float3 viewDir,
                           float shift1, float shift2,
                           float width1, float width2)
    {
        // Shift the tangent direction along the normal for anisotropic offset
        // 沿法线方向偏移切线，控制高光环位置
        float3 shiftedTangent1 = normalize(tangent + normal * shift1);
        float3 shiftedTangent2 = normalize(tangent + normal * shift2);
        
        // Kajiya-Kay: sin(T·L, T·V) based specular
        // 基于 sin(T·L, T·V) 的Kajiya-Kay各向异性高光
        float TdotL1 = dot(shiftedTangent1, lightDir);
        float TdotV1 = dot(shiftedTangent1, viewDir);
        float sinTL1 = sqrt(saturate(1.0 - TdotL1 * TdotL1));
        float sinTV1 = sqrt(saturate(1.0 - TdotV1 * TdotV1));
        float spec1 = saturate(sinTL1 * sinTV1 - TdotL1 * TdotV1);
        
        float TdotL2 = dot(shiftedTangent2, lightDir);
        float TdotV2 = dot(shiftedTangent2, viewDir);
        float sinTL2 = sqrt(saturate(1.0 - TdotL2 * TdotL2));
        float sinTV2 = sqrt(saturate(1.0 - TdotV2 * TdotV2));
        float spec2 = saturate(sinTL2 * sinTV2 - TdotL2 * TdotV2);
        
        // Width controls sharpness of each layer (宽度控制每层的锐度)
        spec1 = pow(spec1, max(width1, 1.0));
        spec2 = pow(spec2, max(width2, 1.0));
        
        // Cel-style hard edge via smoothstep (卡通硬边)
        // Primary: very sharp (主高光：非常锐利)
        float hardSpec1 = smoothstep(0.3, 0.5, spec1);
        // Secondary: softer, broader (次高光：更柔和、更宽)
        float softSpec2 = smoothstep(0.1, 0.4, spec2);
        
        // Combine: primary dominates, secondary adds subtle depth
        // 合成：主高光主导，次高光增加微妙层次感
        float combined = saturate(hardSpec1 + softSpec2 * 0.4);
        
        return float3(combined, combined, combined);
    }

    // Sharp eye specular highlight (锐利眼睛高光)
    // Creates the characteristic bright dot/crescent in anime eyes
    // 创建动漫眼睛中特征性的亮点（光点/月牙形）
    float3 ComputeEyeSpec(float3 normal, float3 lightDir, float3 viewDir, float size)
    {
        // Half vector (半角向量)
        float3 halfVec = normalize(lightDir + viewDir);
        float NdotH = saturate(dot(normal, halfVec));
        
        // Eye specular uses very high power for concentrated highlight
        // 眼睛高光使用极高次幂产生集中的亮点
        float specPower = max(size, 1.0);
        float spec = pow(NdotH, specPower);
        
        // Extra sharp cel edge for eye highlight (眼睛高光使用超锐利的卡通边缘)
        float hardEdge = smoothstep(0.45, 0.55, spec);
        
        // Boost intensity for the characteristic bright eye sparkle
        // 增强强度以产生特征性的明亮眼睛闪光
        hardEdge = saturate(hardEdge * 1.5);
        
        return float3(hardEdge, hardEdge, hardEdge);
    }
};

#endif // MMD_ANIME_SPECULAR_PP_USH
