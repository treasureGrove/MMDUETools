// TMMDAnimeSkin.usf
//
// 皮肤 Toon 光照：只算光照部分（类似 UE shading model），输出 = BaseColor * 累计光照。
// 用 struct 包装逻辑——Custom 节点内不能定义独立函数，但 struct 是"类型声明"，
// 函数体内合法，所以这是节点里做函数复用的标准写法。纯插件实现，不改引擎、不用 #define。
//
// Custom 节点用法（文件末尾自行实例化 + return，所以节点只需一行 include）：
//   OutputType: float3
//   Code:
//     #include "/Plugin/Ue5MMDTools/TMMDShader/TMMDAnimeSkin.usf"
//     return 0;   // 兜底返回值（正常不可达），防止某些编译变体报"无返回值"错误
//
//   节点输入（需连线）：
//     BaseColor     (float3)    - 基础色（来自你自己的 BaseColor HLSL 节点）
//     LightDataTex  (Texture2D) - 灯光数据 RT (/Ue5MMDTools/Rendering/LightDataRT)
//     ShadowStep    (float)
//     HighlightStep (float)
//     ShadowColor   (float3)
//
//   节点作用域自动提供（无需连线）：
//     Parameters          - FMaterialPixelParameters
//     LightDataTexSampler - LightDataTex 自动生成的采样器
//
// 光照累计为 ADDITIVE：每盏灯贡献 (color * intensity / PI) * toonRamp(NdotL) * attenuation。
// 除以 PI 让响应强度接近 PBR（默认强度 ~3.14 的平行光 ≈ 1.0）。天空环境光用与 PBR 相同的
// SH 公式（GetSkySHDiffuse * View.SkyLightColor），天空为空时同为 0，两者不会打架。
struct TMMDAnimeSkin
{
    // Toon 明暗阶：阴影与受光之间的硬阈值。
    float ToonRamp(float ShadowStep, float NdotL)
    {
        return smoothstep(ShadowStep - 0.05, ShadowStep + 0.05, NdotL);
    }

    // 天空环境光：与 PBR 相同的 SH 公式，完全跟随 PBR 的天空环境光。
    float3 SkyAmbient(float3 WorldNormal)
    {
        float4 NrmV = float4(WorldNormal, 1.0);
        float3 I0 = float3(dot(View.SkyIrradianceEnvironmentMap[0], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[1], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[2], NrmV));
        float4 VB = NrmV.xyzz * NrmV.yzzx;
        float3 I1 = float3(dot(View.SkyIrradianceEnvironmentMap[3], VB),
                           dot(View.SkyIrradianceEnvironmentMap[4], VB),
                           dot(View.SkyIrradianceEnvironmentMap[5], VB));
        float  VC  = NrmV.x * NrmV.x - NrmV.y * NrmV.y;
        return max(float3(0, 0, 0), I0 + I1 + View.SkyIrradianceEnvironmentMap[6].xyz * VC);
    }

    // 主入口：累加直接光 + 天空环境光，最后乘上基础色。
    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 BaseColor,
                       Texture2D LightDataTex,
                       SamplerState LightDataTexSampler,
                       float ShadowStep,
                       float HighlightStep,
                       float3 ShadowColor)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;   // MaxLights * 4
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos    = LWCToFloat(Parameters.AbsoluteWorldPosition);
        const float3 WorldNormal = normalize((float3)Parameters.TangentToWorld[2]);

        float3 Lighting = float3(0, 0, 0);

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten = 1.0;

                if (P.w < 1.5)          // 点光
                {
                    float3 ToLight = P.xyz - WorldPos;
                    float  Dist    = length(ToLight);
                    L = ToLight / max(Dist, 0.0001);
                    Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
                }
                else if (P.w < 2.5)     // 聚光
                {
                    float3 ToLight = P.xyz - WorldPos;
                    float  Dist    = length(ToLight);
                    L = ToLight / max(Dist, 0.0001);
                    Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
                    Atten *= smoothstep(T.y, T.x, dot(-L, D.xyz));
                }
                else if (P.w < 3.5)     // 平行光
                {
                    L = -normalize(D.xyz);
                }
                else                    // 矩形/面光
                {
                    float3 ToLight = P.xyz - WorldPos;
                    float  Dist    = length(ToLight);
                    L = ToLight / max(Dist, 0.0001);
                    Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
                    Atten *= smoothstep(0.0, 0.25, dot(L, D.xyz));
                }

                float  NdotL   = saturate(dot(WorldNormal, L));
                float  Ramp    = ToonRamp(ShadowStep, NdotL);
                float3 Diffuse = lerp(ShadowColor, float3(1, 1, 1), Ramp);

                Lighting += C.rgb * (C.w / ToonPI) * Diffuse * Atten;
            }
        }

        Lighting += SkyAmbient(WorldNormal) * View.SkyLightColor.rgb;

        // HighlightStep 暂未使用，保留参数以保持接口一致（高光阶还没接）。
        return BaseColor * Lighting;
    }
};

// 自包含入口：文件在 Custom 节点内展开后直接 return，所以节点代码只需上面的 include。
// （若材质想在此基础上继续叠加，删掉这两行，手动调用 Skin.OutputColor(...) 即可。）
TMMDAnimeSkin Skin;
return Skin.OutputColor(Parameters,
                        BaseColor, LightDataTex, LightDataTexSampler,
                        ShadowStep, HighlightStep, ShadowColor);

