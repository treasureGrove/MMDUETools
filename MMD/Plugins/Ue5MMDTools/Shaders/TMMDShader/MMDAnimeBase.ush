
#include "/Plugin/Ue5MMDTools/TShaderFunctionLibrary/AnimeLightingCommon.usf"
#include "/Plugin/Ue5MMDTools/TShaderFunctionLibrary/AnimeEnvironment.usf"
#include "/Plugin/Ue5MMDTools/TShaderFunctionLibrary/ColorAdjustment.usf"

// ============================================================================
// TMMDAnimeBase
// Main body/cloth anime shader for Custom HLSL material node.
//
// input parameters (connect in material editor):
//   float4 base_color_map_value  - albedo texture sample
//   float3 shadow_color          - shadow tint color           [default: 0.2,0.2,0.3]
//   float  shadow_threshold      - shadow cutoff [-1..1]       [default: 0.2]
//   float  shadow_softness       - shadow edge width [0..1]    [default: 0.02]
//   float  rim_width             - rim light width [0..1]      [default: 0.3]
//   float3 rim_color             - rim light tint              [default: 1,1,1]
//   float  environment_strength  - ambient/env blend [0..1]    [default: 0.3]
//   float  specular_size         - specular lobe size [0..1]   [default: 0.5]
//   float  specular_hardness     - specular sharpness [1..64]  [default: 8.0]
// ============================================================================

struct TMMDAnimeBase
{
    float4 OutputColor(FMaterialPixelParameters material_parameters,
                       float4 base_color_map_value,
                       float3 shadow_color,
                       float shadow_threshold,
                       float shadow_softness,
                       float rim_width,
                       float3 rim_color,
                       float environment_strength,
                       float specular_size,
                       float specular_hardness)
    {
        // -- Utility structs --
        TAnimeLightingCommon lighting;
        TAnimeEnvironment    environment;
        TColorAdjustment     colorAdj;

        // -- Core vectors --
        float3 view_dir     = normalize(material_parameters.CameraVector);
        float3 pixel_normal = normalize(material_parameters.WorldNormal * material_parameters.TwoSidedSign);

        // 1. Main light + ambient from environment
        float3 light_dir   = environment.GetMainLightDirection();
        float3 light_color = environment.GetMainLightColor();
        float  light_int   = environment.GetMainLightIntensity();
        float3 ambient     = environment.GetAmbientColor(pixel_normal);

        // 2. NdotL, NdotV
        float ndotl = dot(pixel_normal, light_dir);
        float ndotv = saturate(dot(pixel_normal, view_dir));

        // 3. Dual-layer toon shadow
        float toon_shadow = lighting.ComputeDualLayerShadow(ndotl, shadow_threshold, shadow_softness, 0.3);

        // 4. Environment-tinted shadow color
        float3 env_tint = environment.GetEnvironmentTint(pixel_normal, environment_strength);
        float3 shadow_tinted = shadow_color * env_tint;

        // 5. Apply shadow to base color
        float3 base_color = colorAdj.SafeColor(base_color_map_value.rgb);
        float3 lit_color   = base_color * saturate(light_color);
        float3 shaded_color = base_color * shadow_tinted;
        float3 result = lerp(shaded_color, lit_color, toon_shadow);

        // Add ambient fill in shadow areas
        float3 gi = environment.ComputeGIResponse(pixel_normal, environment_strength);
        result += base_color * gi * (1.0 - toon_shadow);

        // 6. Rim light (weighted to light side)
        float rim_mask = lighting.ComputeRimMask(ndotv, rim_width, 0.1);
        float rim_light_weight = saturate(ndotl * 0.5 + 0.5); // brighter on lit side
        float3 rim_contrib = rim_color * rim_mask * rim_light_weight;
        result += rim_contrib;

        // 7. Anime specular
        float spec = lighting.ComputeAnimeSpecular(pixel_normal, light_dir, view_dir, specular_size, specular_hardness);
        result += float3(1.0, 1.0, 1.0) * spec * toon_shadow; // only on lit side

        return float4(max(result, 0.0), base_color_map_value.a);
    }
};
TMMDAnimeBase MMDShader;
return MMDShader.OutputColor(Parameters, base_color_map_value, shadow_color, shadow_threshold, shadow_softness, rim_width, rim_color, environment_strength, specular_size, specular_hardness);
