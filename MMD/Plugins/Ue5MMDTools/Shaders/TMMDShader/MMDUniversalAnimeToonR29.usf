// R29 华丽重映射：保护纹理线稿，重塑肤色/布料，并扩展点光背光带。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonImplementationR25.usf"

struct TMMDUniversalAnimeToonR29
{
    float3 ComputeWideSceneRim(TMMDUniversalAnimeToonR25 base_toon,
                               Texture2D light_data_tex,
                               SamplerState light_data_tex_sampler,
                               float3 world_pos,
                               float3 world_normal,
                               float3 view_direction,
                               float light_color_influence,
                               float glamour_rim_strength)
    {
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float silhouette = saturate(1.0 - n_dot_v);
        float broad_rim = smoothstep(0.38, 0.76, silhouette);
        float core_rim = smoothstep(0.76, 0.955, silhouette);
        float3 rim_sum = 0.0;

        [unroll]
        for (int i = 0; i < 16; ++i)
        {
            float4 P;
            float4 C;
            float4 D;
            float4 T;
            base_toon.SampleLight(light_data_tex, light_data_tex_sampler, i, P, C, D, T);
            if (P.w >= 0.5 && !(P.w >= 2.5 && P.w < 3.5))
            {
                float3 L;
                float attenuation;
                base_toon.LightParams(P, D, T, world_pos, L, attenuation);
                float color_max = max(max(C.r, C.g), max(C.b, 0.001));
                float3 light_hue = max(C.rgb, 0.0) / color_max;
                float tint_amount = saturate(0.52 + light_color_influence * 0.52);
                float3 rim_color = lerp(float3(1.0, 1.0, 1.0), light_hue, tint_amount);
                float energy = (1.0 - exp(-max(C.w, 0.0))) * attenuation;
                float n_dot_l = dot(world_normal, L);
                float backlight_gate = smoothstep(-0.48, 0.20, -n_dot_l);
                rim_sum += rim_color * (broad_rim * 0.24 + core_rim * 0.92) *
                           backlight_gate * energy;
            }
        }

        return 1.0 - exp(-rim_sum * max(glamour_rim_strength, 0.0) * 0.62);
    }

    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR25 base_toon;
        float3 shaded_color = base_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));

        float diffuse_max = max(max(diffuse_color.r, diffuse_color.g), diffuse_color.b);
        float3 safe_diffuse = diffuse_max > 0.001 ? max(diffuse_color, 0.0) :
                              float3(1.0, 1.0, 1.0);
        float3 source_color = max(base_texture_color, 0.0) * safe_diffuse;
        float source_luma = base_toon.Luminance(source_color);
        float3 source_chroma = source_color - source_luma;

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }

        float n_dot_l = dot(world_normal, key_direction);
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float silhouette = saturate(1.0 - n_dot_v);
        float mid_band = smoothstep(-0.30, 0.04, n_dot_l);
        float lit_band = smoothstep(0.20, 0.46, n_dot_l);

        float skin_detail = lerp(0.82, 1.08, saturate(source_luma * 1.18));
        float3 skin_shadow = float3(0.61, 0.40, 0.43) * skin_detail + source_chroma * 0.22;
        float3 skin_mid = float3(0.90, 0.69, 0.68) * skin_detail + source_chroma * 0.24;
        float3 skin_lit = float3(1.02, 0.84, 0.79) * skin_detail + source_chroma * 0.26;
        float3 skin_layered = lerp(skin_shadow, skin_mid, mid_band);
        skin_layered = lerp(skin_layered, skin_lit, lit_band);
        float skin_side = smoothstep(0.20, 0.64, silhouette) *
                          (1.0 - smoothstep(0.84, 0.98, silhouette));
        skin_layered += float3(0.055, 0.007, 0.014) * skin_side;
        float skin_texture_gate = smoothstep(0.18, 0.48, source_luma);
        shaded_color = lerp(shaded_color, skin_layered,
                            profile_skin * skin_texture_gate * 0.92);

        float white_detail = lerp(0.76, 1.07,
                                  saturate((source_luma - 0.24) * 1.42));
        float3 white_shadow = float3(0.47, 0.53, 0.65) * white_detail;
        float3 white_mid = float3(0.82, 0.85, 0.91) * white_detail;
        float3 white_lit = float3(1.06, 1.06, 1.10) * white_detail;
        float3 white_layered = lerp(white_shadow, white_mid, mid_band);
        white_layered = lerp(white_layered, white_lit, lit_band);
        float white_texture_gate = smoothstep(0.28, 0.58, source_luma);
        shaded_color = lerp(shaded_color, white_layered,
                            profile_white_cloth * white_texture_gate * 0.94);

        float black_mid_band = smoothstep(-0.38, 0.02, n_dot_l);
        float black_lit_band = smoothstep(0.20, 0.54, n_dot_l);
        float3 black_shadow = float3(0.012, 0.016, 0.026) + source_color * 0.10;
        float3 black_mid = float3(0.078, 0.090, 0.124) + source_color * 0.16;
        float3 black_lit = float3(0.225, 0.232, 0.278) + source_color * 0.18;
        float3 black_layered = lerp(black_shadow, black_mid, black_mid_band);
        black_layered = lerp(black_layered, black_lit, black_lit_band);
        float black_inner_ink = smoothstep(0.80, 0.97, silhouette);
        black_layered *= 1.0 - black_inner_ink * 0.30;
        shaded_color = lerp(shaded_color, black_layered, profile_black_satin * 0.95);

        float shared_profile = saturate(profile_skin + profile_white_cloth + profile_black_satin);
        float ink_core = smoothstep(0.91, 0.988, silhouette);
        shaded_color *= 1.0 - ink_core * shared_profile * 0.24;

        float3 wide_scene_rim = ComputeWideSceneRim(
            base_toon,
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            world_normal,
            view_direction,
            light_color_influence,
            glamour_rim_strength
        );
        float wide_rim_gain = 0.64 + profile_hair * 0.20 +
                              profile_white_cloth * 0.10 +
                              profile_black_satin * 0.26 -
                              profile_skin * 0.12;
        shaded_color += wide_scene_rim * wide_rim_gain;

        return min(max(shaded_color, 0.0), 3.00);
    }
};

TMMDUniversalAnimeToonR29 universal_anime_toon;
return universal_anime_toon.OutputColor(
    Parameters,
    base_color,
    light_data_tex,
    light_data_texSampler,
    shadow_step,
    shadow_softness,
    shadow_strength,
    ambient_strength,
    light_color_influence,
    highlight_step,
    highlight_strength,
    rim_strength,
    rim_power,
    local_light_strength,
    local_specular_strength,
    glamour_rim_strength,
    directional_sheen_strength,
    surface_profile,
    base_texture_color,
    diffuse_color
);
