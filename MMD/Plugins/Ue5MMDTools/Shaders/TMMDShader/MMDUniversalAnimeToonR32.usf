// R32 场景融合：点光色进入表面色阶，头发保持浓郁色相。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonR31.usf"

struct TMMDUniversalAnimeToonR32
{
    float3 ComputeLocalToonFill(TMMDUniversalAnimeToonR25 base_toon,
                                Texture2D light_data_tex,
                                SamplerState light_data_tex_sampler,
                                float3 world_pos,
                                float3 world_normal,
                                float3 view_direction,
                                float light_color_influence,
                                float local_light_strength)
    {
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float silhouette = saturate(1.0 - n_dot_v);
        float side_gain = lerp(0.12, 0.34, smoothstep(0.18, 0.72, silhouette));
        float3 fill_sum = 0.0;

        [unroll]
        for (int i = 0; i < 16; ++i)
        {
            float4 P;
            float4 C;
            float4 D;
            float4 T;
            base_toon.SampleLight(light_data_tex, light_data_tex_sampler, i, P, C, D, T);
            if (P.w >= 0.5 && !(P.w >= 2.5 && P.w < 3.5))
            {
                float3 L;
                float attenuation;
                base_toon.LightParams(P, D, T, world_pos, L, attenuation);
                float color_max = max(max(C.r, C.g), max(C.b, 0.001));
                float3 light_hue = max(C.rgb, 0.0) / color_max;
                float tint_amount = saturate(0.64 + light_color_influence * 0.46);
                float3 toon_hue = lerp(float3(1.0, 1.0, 1.0), light_hue, tint_amount);
                float energy = (1.0 - exp(-max(C.w, 0.0) * 0.82)) * attenuation;
                float light_band = smoothstep(-0.14, 0.14, dot(world_normal, L));
                fill_sum += toon_hue * energy * light_band * side_gain;
            }
        }

        return 1.0 - exp(-fill_sum * max(local_light_strength, 0.0) * 0.72);
    }

    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR31 layered_toon;
        float3 shaded_color = layered_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        TMMDUniversalAnimeToonR25 base_toon;
        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));
        float profile_eye = 1.0 - step(0.5, abs(surface_profile - 5.0));
        float profile_hair_shadow = 1.0 - step(0.5, abs(surface_profile - 6.0));

        float diffuse_max = max(max(diffuse_color.r, diffuse_color.g), diffuse_color.b);
        float3 safe_diffuse = diffuse_max > 0.001 ? max(diffuse_color, 0.0) :
                              float3(1.0, 1.0, 1.0);
        float3 source_color = max(base_texture_color, 0.0) * safe_diffuse;
        float source_luma = base_toon.Luminance(source_color);
        float3 vivid_source = max(source_luma + (source_color - source_luma) * 1.32, 0.0);

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }

        float n_dot_l = dot(world_normal, key_direction);
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float scene_balance = saturate(0.62 + max(ambient_strength, 0.0) * 0.50);
        float3 half_vector = base_toon.SafeNormalize(key_direction + view_direction,
                                                     view_direction);
        float n_dot_h = saturate(dot(world_normal, half_vector));
        float hair_mid_band = smoothstep(-0.22, 0.02, n_dot_l);
        float hair_lit_band = smoothstep(0.36, 0.56, n_dot_l);
        float hair_level = lerp(0.40, 0.76, hair_mid_band);
        hair_level = lerp(hair_level, 1.03, hair_lit_band);
        float3 hair_layered = vivid_source * hair_level * scene_balance;
        hair_layered = max(hair_layered, shaded_color * 0.48);
        shaded_color = lerp(shaded_color, hair_layered, profile_hair * 0.70);

        float black_front = smoothstep(0.50, 0.91, n_dot_v);
        float3 black_front_color = float3(0.340, 0.342, 0.385) *
                                   lerp(scene_balance, 1.0, 0.35);
        shaded_color = lerp(shaded_color,
                            max(shaded_color, black_front_color),
                            profile_black_satin * black_front * 0.80);

        float3 local_fill = ComputeLocalToonFill(
            base_toon,
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            world_normal,
            view_direction,
            light_color_influence,
            local_light_strength
        );
        float local_gain = profile_skin * 0.14 +
                           profile_hair * 0.16 +
                           profile_white_cloth * 0.26 +
                           profile_black_satin * 0.20 +
                           profile_eye * 0.08 +
                           profile_hair_shadow * 0.02;
        shaded_color += local_fill * local_gain;

        float3 eye_vivid = max(source_luma + (source_color - source_luma) * 1.20, 0.0) *
                           float3(0.97, 1.01, 1.08);
        float eye_light_band = smoothstep(-0.18, 0.14, n_dot_l);
        float3 eye_layered = eye_vivid * lerp(0.88, 1.10, eye_light_band) +
                             float3(0.012, 0.030, 0.052);
        float eye_white_gate = smoothstep(0.72, 0.94, source_luma);
        eye_layered = lerp(eye_layered, source_color * 1.04, eye_white_gate);
        float eye_glint = smoothstep(0.955, 0.986, n_dot_h);
        eye_layered += float3(0.72, 0.90, 1.00) * eye_glint * 0.12;
        eye_layered *= scene_balance;
        shaded_color = lerp(shaded_color, eye_layered, profile_eye * 0.72);

        float3 hair_shadow_tone = float3(0.070, 0.026, 0.036) +
                                  source_luma * float3(0.105, 0.060, 0.068);
        hair_shadow_tone *= scene_balance;
        shaded_color = lerp(shaded_color, hair_shadow_tone,
                            profile_hair_shadow * 0.94);

        return min(max(shaded_color, 0.0), 3.50);
    }
};
