// R55 英雄轮廓：按真实 MMD 法线放宽珠光覆盖，并提高黑缎观察面输出级。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonR54.usf"

struct TMMDUniversalAnimeToonR55
{
    float3 ComputeWideJewelRim(TMMDUniversalAnimeToonR25 base_toon,
                               Texture2D light_data_tex,
                               SamplerState light_data_tex_sampler,
                               float3 world_pos,
                               float3 shading_normal,
                               float3 view_direction)
    {
        float silhouette = saturate(1.0 - dot(shading_normal, view_direction));
        float broad_rim = smoothstep(0.28, 0.78, silhouette);
        float core_rim = smoothstep(0.70, 0.94, silhouette);
        float3 rim_sum = 0.0;

        [unroll]
        for (int i = 0; i < 16; ++i)
        {
            float4 P;
            float4 C;
            float4 D;
            float4 T;
            base_toon.SampleLight(light_data_tex, light_data_tex_sampler, i, P, C, D, T);
            if (P.w >= 0.5 && !(P.w >= 2.5 && P.w < 3.5))
            {
                float3 L;
                float attenuation;
                base_toon.LightParams(P, D, T, world_pos, L, attenuation);
                float energy = (1.0 - exp(-max(C.w, 0.0) * 0.36)) * attenuation;
                float color_max = max(max(C.r, C.g), max(C.b, 0.001));
                float3 light_hue = max(C.rgb, 0.0) / color_max;
                float backlight = smoothstep(-0.18, 0.64, -dot(L, view_direction));
                rim_sum += light_hue * energy * backlight *
                           (broad_rim * 0.62 + core_rim * 0.86);
            }
        }

        return 1.0 - exp(-rim_sum * 1.34);
    }

    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR54 layered_toon;
        float3 shaded_color = layered_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        TMMDUniversalAnimeToonR25 base_toon;
        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));
        float profile_hair_shadow = 1.0 - step(0.5, abs(surface_profile - 6.0));

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));
        float view_sign = dot(world_normal, view_direction) >= 0.0 ? 1.0 : -1.0;
        float3 shading_normal = world_normal * view_sign;
        float n_dot_v = saturate(dot(shading_normal, view_direction));

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }

        float black_front = smoothstep(0.05, 0.72, n_dot_v);
        float black_light = smoothstep(-0.20, 0.42, dot(shading_normal, key_direction));
        float black_level = 0.080 + black_front * 0.465 + black_light * 0.165;
        float3 black_target = float3(0.90, 0.93, 1.04) * black_level;
        shaded_color = lerp(shaded_color,
                            max(shaded_color, black_target),
                            profile_black_satin * 0.97);

        float3 wide_rim = ComputeWideJewelRim(
            base_toon,
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            shading_normal,
            view_direction
        );
        float rim_gain = 0.04 + profile_hair * 0.78 +
                         profile_white_cloth * 0.46 +
                         profile_black_satin * 0.88 -
                         profile_skin * 0.04 -
                         profile_hair_shadow * 0.04;
        shaded_color += pow(max(wide_rim, 0.0), 0.74) *
                        max(rim_gain, 0.0) * 0.72;

        return min(max(shaded_color, 0.0), 3.50);
    }
};
