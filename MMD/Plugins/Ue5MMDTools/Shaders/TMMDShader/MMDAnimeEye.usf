// MMDAnimeEye.usf
//
// 二次元（アニメ）眼睛材质（单独处理）：调用 Core/MMDToonLighting.ush 拿光照，
// 按动漫眼睛的特征重构（与基础材质区分）：
//   - 虹膜自发光：只有虹膜"亮着"，阴影里也保持明亮；眼白正常受光、阴影里变灰（保留色相）；
//   - 白高光（キャッチライト/glint）：虹膜上方固定的白色圆斑，二次元眼睛的灵魂；
//   - 上睫毛阴影：眼睛上部眼睑投影，柔和压暗；
//   - 虹膜下缘提亮：上深下浅的水灵渐变；
//   - 湿润高光：highlight_step 驱动的锐利 toon 高光（不再只靠软高光）。
//
// Custom 节点用法：
//   OutputType: float3
//   Code:
//     #include "/Plugin/Ue5MMDTools/TMMDShader/MMDAnimeEye.usf"
//     return 0;   // 兜底返回值（正常不可达）
//
//   节点输入（需连线）：
//     base_color     (float3)    - 眼睛贴图颜色（base_color × base_color_map）
//     light_data_tex (Texture2D) - 灯光数据 RT
//     shadow_step    (float)     - 卡通阴影阈值
//     highlight_step (float)     - 湿润高光阈值（锐利高光阶，建议 0.85）
//     shadow_color   (float3)    - 阴影压暗色（保留色相，建议 0.5~0.6 灰）
//     specular_power (float)     - 软高光锐度（眼珠光泽，~100）
//     mat_cap        (Texture2D) - 球面贴图（眼睛用 add 模式的 spa 做湿润高光）
//     sphere_mode    (float)     - 0=关 1=乘 2=加
//
//   新增二次元眼睛输入（务必在 Custom 节点 Details 里加这 6 个输入并设默认值；
//   不连线时按 0 处理）：
//     iris_glow      (float)  - 虹膜自发光强度（建议 1.0；0 也有保底亮度）
//     glint_strength (float)  - 白高光强度（0=关，建议 1.0~2.0）
//     glint_pos      (float2) - 白高光在眼睛 UV 中的位置（建议 0.5, 0.42 偏上）
//     glint_size     (float)  - 白高光半径（UV 单位，建议 0.05）
//     top_shadow     (float)  - 上睫毛阴影强度（建议 0.5~0.8）
//     bottom_lift    (float)  - 虹膜下缘提亮强度（建议 0.5~0.8）
//
//   节点作用域自动提供（无需连线）：
//     Parameters / light_data_texSampler / mat_capSampler
//
//   注意：默认假设眼睛 UV 顶部在 y=0（上眼睑在上）。若模型 UV 上下翻转，
//   把 EyelashShadow / IrisBottomGrad 里的 eye_uv.y 换成 1.0 - eye_uv.y。
#include "/Plugin/Ue5MMDTools/Core/MMDToonLighting.ush"

struct TMMDAnimeEye
{
    // 眼白/虹膜区分：虹膜=1，眼白=0。
    // 眼白高亮低饱和；虹膜偏暗且高饱和（亮蓝这类也判为虹膜）。
    float IrisMask(float3 base_color)
    {
        float luma = dot(base_color, float3(0.299, 0.587, 0.114));
        float max_c = max(base_color.r, max(base_color.g, base_color.b));
        float min_c = min(base_color.r, min(base_color.g, base_color.b));
        float sat   = max_c - min_c;
        return saturate((1.0 - smoothstep(0.55, 0.85, luma)) + sat * 0.75);
    }

    // 白高光：虹膜上方固定的柔和圆斑，pow 提锐边缘。
    float Glint(float2 eye_uv, float2 glint_pos, float glint_size)
    {
        float d = distance(eye_uv, glint_pos);
        float g = exp(-d * d / (2.0 * glint_size * glint_size));
        return pow(saturate(g), 4.0);
    }

    // 上睫毛阴影：从 UV 顶部向下淡出的投影（默认顶部在 y=0）。
    float EyelashShadow(float2 eye_uv)
    {
        return 1.0 - smoothstep(0.03, 0.32, eye_uv.y);
    }

    // 虹膜下缘提亮：上深下浅。
    float IrisBottomGrad(float2 eye_uv)
    {
        return smoothstep(0.30, 0.75, eye_uv.y);
    }

    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_texSampler,
                       float shadow_step,
                       float highlight_step,
                       float3 shadow_color,
                       float specular_power,
                       Texture2D mat_cap,
                       SamplerState mat_capSampler,
                       float sphere_mode,
                       float iris_glow,
                       float glint_strength,
                       float2 glint_pos,
                       float glint_size,
                       float top_shadow,
                       float bottom_lift)
    {
        const float3 world_pos    = LWCToFloat(Parameters.AbsoluteWorldPosition);
        const float3 world_normal = normalize((float3)Parameters.TangentToWorld[2]);
        const float3 view_dir     = normalize(LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos);
        const float2 eye_uv       = Parameters.TexCoords[0];

        // 湿润高光阈值：未接线（0）时给默认值 0.85
        float wet_step = highlight_step > 0.01 ? highlight_step : 0.85;

        TMMDToonLight tl;
        float3 diffuse, dir_light, specular;
        tl.ComputeLighting(Parameters, light_data_tex, light_data_texSampler, specular_power,
                           world_normal, view_dir, diffuse, dir_light, specular);

        // 受光量 + 两阶 ramp
        const float3 luma_w = float3(0.299, 0.587, 0.114);
        float light_amount = saturate(dot(dir_light, luma_w));
        float ramp = smoothstep(shadow_step - 0.08, shadow_step + 0.08, light_amount);

        // 阴影色（保留色相）
        float3 shadow_tone = base_color * saturate(shadow_color);

        // ---- 眼白/虹膜拆分 ----
        // 眼白：0.30 自环境底 + 受光（阴影区用压暗色，保留色相）；
        // 虹膜：自发光为主（阴影里保持"亮着"），受光只轻微提亮。
        float iris_m    = IrisMask(base_color);
        float eye_self  = 0.55 + 0.45 * iris_glow;

        float3 sclera = base_color * 0.30 + lerp(shadow_tone, base_color * diffuse, ramp) * 0.70;
        float3 iris   = base_color * (eye_self + diffuse * 0.40 * ramp);
        float3 final  = lerp(sclera, iris, iris_m);

        // 天空环境（眼白受一点环境）
        final += base_color * tl.SkyAmbient(world_normal) * View.SkyLightColor.rgb * 0.4 * (1.0 - iris_m);

        // ---- 高光叠加（软 + 湿润锐高光）----
        final += specular * ramp;
        float3 wet_spec = tl.ToonSpecularLight(Parameters, light_data_tex, light_data_texSampler,
                                               world_normal, view_dir, wet_step, 0.08, 2.5);
        final += wet_spec * ramp;

        // ---- MMD sphere/matcap ----
        if (sphere_mode > 0.5)
        {
            float3 matcap = tl.SampleMatcap(world_normal, mat_cap, mat_capSampler);

            if (sphere_mode < 1.5)       // 乘：matcap 烘焙阴影只乘眼白，虹膜保持自发光
            {
                final = lerp(sclera * matcap, iris, iris_m);
            }
            else                        // 加：眼睛的湿润高光
            {
                final += matcap;
            }
        }

        // ---- 上睫毛阴影 ----
        if (top_shadow > 0.001)
        {
            final *= 1.0 - EyelashShadow(eye_uv) * top_shadow * 0.55;
        }

        // ---- 虹膜下缘提亮（上深下浅）----
        if (bottom_lift > 0.001)
        {
            final += base_color * bottom_lift * IrisBottomGrad(eye_uv) * iris_m * 0.35;
        }

        // ---- 白高光（キャッチライト）----
        if (glint_strength > 0.001)
        {
            float n_dot_v = saturate(dot(world_normal, view_dir));
            float fres  = smoothstep(0.15, 0.55, n_dot_v);   // 侧面视角淡出
            final += float3(1, 1, 1) * glint_strength * Glint(eye_uv, glint_pos, max(glint_size, 0.001)) * iris_m * fres;
        }

        return final;
    }
};

// 自包含入口
TMMDAnimeEye eye;
return eye.OutputColor(Parameters,
                       base_color, light_data_tex, light_data_texSampler,
                       shadow_step, highlight_step, shadow_color,
                       specular_power,
                       mat_cap, mat_capSampler, sphere_mode,
                       iris_glow, glint_strength, glint_pos, glint_size,
                       top_shadow, bottom_lift);
