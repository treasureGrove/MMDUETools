// R54 华丽度升级：高能窄 Rim、纹理保真肤面与白布、稳定可见的黑缎观察面灰阶。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonR53.usf"

struct TMMDUniversalAnimeToonR54
{
    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR53 layered_toon;
        float3 shaded_color = layered_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        TMMDUniversalAnimeToonR25 base_toon;
        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));
        float profile_hair_shadow = 1.0 - step(0.5, abs(surface_profile - 6.0));

        float diffuse_max = max(max(diffuse_color.r, diffuse_color.g), diffuse_color.b);
        float3 safe_diffuse = diffuse_max > 0.001 ? max(diffuse_color, 0.0) :
                              float3(1.0, 1.0, 1.0);
        float3 source_color = max(base_texture_color, 0.0) * safe_diffuse;
        float source_luma = base_toon.Luminance(source_color);
        float3 vivid_source = max(source_luma + (source_color - source_luma) * 1.38, 0.0);
        float vivid_luma = max(base_toon.Luminance(vivid_source), 0.004);

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));
        float view_sign = dot(world_normal, view_direction) >= 0.0 ? 1.0 : -1.0;
        float3 shading_normal = world_normal * view_sign;
        float n_dot_v = saturate(dot(shading_normal, view_direction));

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }
        float n_dot_l = dot(shading_normal, key_direction);

        float black_front = smoothstep(0.08, 0.76, n_dot_v);
        float black_light = smoothstep(-0.18, 0.44, n_dot_l);
        float black_level = 0.070 + black_front * 0.325 + black_light * 0.145;
        float3 black_target = float3(0.90, 0.93, 1.04) * black_level;
        shaded_color = lerp(shaded_color,
                            max(shaded_color, black_target),
                            profile_black_satin * 0.96);

        float skin_front = smoothstep(0.22, 0.84, n_dot_v);
        float3 skin_target = source_color * float3(1.045, 0.970, 0.955) * 0.80 +
                             float3(0.014, 0.004, 0.003);
        shaded_color = lerp(shaded_color,
                            skin_target,
                            profile_skin * skin_front * 0.76);

        float white_front = smoothstep(0.18, 0.78, n_dot_v);
        float3 white_target = source_color *
                              lerp(float3(0.72, 0.76, 0.84),
                                   float3(0.91, 0.93, 0.98),
                                   black_light);
        shaded_color = lerp(shaded_color,
                            max(shaded_color, white_target),
                            profile_white_cloth * white_front * 0.68);

        float hair_front = smoothstep(0.22, 0.82, n_dot_v);
        float hair_target_luma = lerp(0.16, 0.29, black_light);
        float3 hair_target = vivid_source * (hair_target_luma / vivid_luma);
        shaded_color = lerp(shaded_color,
                            hair_target,
                            profile_hair * hair_front * 0.34);

        TMMDUniversalAnimeToonR53 rim_toon;
        float directional_presence;
        float3 jewel_rim = rim_toon.ComputeJewelRim(
            base_toon,
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            shading_normal,
            view_direction,
            directional_presence
        );
        float rim_gain = 0.16 + profile_hair * 0.92 +
                         profile_white_cloth * 0.70 +
                         profile_black_satin * 1.00 -
                         profile_skin * 0.10 -
                         profile_hair_shadow * 0.16;
        shaded_color += pow(max(jewel_rim, 0.0), 0.68) *
                        max(rim_gain, 0.0) * 1.24;

        return min(max(shaded_color, 0.0), 3.50);
    }
};
