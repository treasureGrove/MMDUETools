#include "/Plugin/Ue5MMDTools/Core/MMDToonLighting.ush"

// Light / LightContext 由 Core 库统一提供（引用 LightDataTex / MMDShadowMap 必需输入）
//----------------------------------------------------------------------------------
struct InputData
{
    // float
    float3 BaseColor;
    // float  MatCapStrength;
    // float  NormalMapStrength;
    // // Texture2D
    // Texture2D    NormalMap;
    // SamplerState NormalMapSampler;
    // Texture2D    MatCap;
    // SamplerState MatCapSampler;
};
//----------------------------------------------------------------------------------
InputData In;
//float
In.BaseColor = BaseColor;
// In.Emission = Emission;
// In.SpecularPower = SpecularPower;
// In.NormalMapStrength = NormalMapStrength;
// In.MatCapStrength = MatCapStrength;
// //Texture2D
// In.NormalMap = NormalMap;
// In.NormalMapSampler = NormalMapSampler;
// In.MatCap = MatCap;
// In.MatCapSampler = MatCapSampler;
struct TMMDMaterialShader
{
    // 只有一个函数：先写好各 pass 的颜色（BaseColor/Emission + 法线/光泽），
    // 再调 TMMDToonLight::ShadeSurface 算光照，最后返回最终颜色。
    TMMDSurfaceData  SurfaceData(FMaterialPixelParameters Parameters, InputData In)
    {
        TMMDSurfaceData Output;

        // 最少输入（仅 BaseColor）：其余字段给默认值兜底。
        // 注意：struct 所有字段都必须赋值，否则 ShadeSurface 读到未初始化值会报
        // "Instructions should not read uninitialized value"。
        Output.BaseColor     = In.BaseColor;
        Output.WorldNormal   = normalize((float3)Parameters.TangentToWorld[2]);  // 几何法线（无法线贴图时）
        Output.SpecularPower = 16.0;                                            // 默认光泽
        Output.Emission      = float3(0, 0, 0);                                 // 无自发光

        return Output;
    }
};

TMMDMaterialShader Shader;
TMMDSurfaceData SurfaceData = Shader.SurfaceData(Parameters, In);

return Light.ShadeSurface(Parameters, SurfaceData, LightContext);
