// R48 华丽度校正：加强窄青粉轮廓，压平皮肤硬亮块，并抬起发色与黑缎体积。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonR47.usf"

struct TMMDUniversalAnimeToonR48
{
    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR47 layered_toon;
        float3 shaded_color = layered_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        TMMDUniversalAnimeToonR25 base_toon;
        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));
        float profile_hair_shadow = 1.0 - step(0.5, abs(surface_profile - 6.0));

        float diffuse_max = max(max(diffuse_color.r, diffuse_color.g), diffuse_color.b);
        float3 safe_diffuse = diffuse_max > 0.001 ? max(diffuse_color, 0.0) :
                              float3(1.0, 1.0, 1.0);
        float3 source_color = max(base_texture_color, 0.0) * safe_diffuse;
        float source_luma = base_toon.Luminance(source_color);
        float3 vivid_source = max(source_luma + (source_color - source_luma) * 1.42, 0.0);
        float vivid_luma = max(base_toon.Luminance(vivid_source), 0.004);

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float scene_exposure = saturate(0.74 + max(ambient_strength, 0.0) * 0.80);

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }
        float key_band = smoothstep(-0.22, 0.34, dot(world_normal, key_direction));

        // 头发的大面保持浓绿，窄轮廓仍由真实局部灯着色。
        float hair_front = smoothstep(0.20, 0.80, n_dot_v);
        float hair_crown = smoothstep(-0.05, 0.68, world_normal.z);
        float hair_target_luma = scene_exposure *
                                 lerp(0.105, 0.265, hair_front * hair_crown) *
                                 lerp(0.84, 1.10, key_band);
        float3 hair_target = vivid_source * (hair_target_luma / vivid_luma);
        shaded_color = lerp(shaded_color,
                            max(shaded_color, hair_target),
                            profile_hair * 0.74);

        // 黑缎只抬受光大面，背面与褶皱继续保持黑位。
        float black_front = smoothstep(0.08, 0.70, n_dot_v);
        float black_level = scene_exposure * black_front * lerp(0.115, 0.235, key_band);
        float3 black_volume = float3(0.91, 0.94, 1.04) * black_level;
        shaded_color = lerp(shaded_color,
                            max(shaded_color, black_volume),
                            profile_black_satin * 0.92);

        // 皮肤按原始色纹理重建柔和正面层，保留五官且压掉局部灯硬亮块。
        float skin_front = smoothstep(0.34, 0.88, n_dot_v);
        float skin_level = scene_exposure * lerp(0.62, 0.78, key_band);
        float3 skin_target = source_color * float3(0.97, 1.00, 1.015) * skin_level;
        float skin_blend = profile_skin * skin_front * 0.56;
        shaded_color = lerp(shaded_color, skin_target, skin_blend);

        // 发影不能继承红色阴影贴图的色相，统一退成随亮度变化的冷暗中性色。
        float shadow_front = lerp(0.74, 1.0, n_dot_v);
        float3 hair_shadow_tone = (float3(0.045, 0.067, 0.061) +
                                   source_luma * float3(0.032, 0.040, 0.036)) *
                                  scene_exposure * shadow_front;
        shaded_color = lerp(shaded_color, hair_shadow_tone, profile_hair_shadow);

        TMMDUniversalAnimeToonR47 rim_toon;
        float3 crisp_rim = rim_toon.ComputeCrispLocalRim(
            base_toon,
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            world_normal,
            view_direction
        );
        float rim_gain = 0.76 + profile_hair * 0.44 +
                         profile_white_cloth * 0.24 +
                         profile_black_satin * 0.38 -
                         profile_skin * 0.26 -
                         profile_hair_shadow * 0.76;
        shaded_color += crisp_rim * max(rim_gain, 0.0) * 0.34;

        return min(max(shaded_color, 0.0), 3.50);
    }
};
