// MMDToonLighting_Archived.ush
//
// 归档：从 MMDToonLighting.ush 里摘出来的、非"阴影采样/应用"的函数。
// 保留在独立 struct 里便于以后参考/恢复。本文件【不被任何材质 include】，纯留档。
// 需要恢复时，把对应函数复制回 MMDToonLighting.ush 的 TMMDToonLight 即可。
//
// 注意：这些函数是 TMMDToonLight 的成员，若你要用，记得把 struct 名改成 TMMDToonLight、
//       或在本 struct TMMDToonLightArchived 下调用（需要实例化）。

struct TMMDToonLightArchived
{
    // toon 阴影 ramp：阴影与受光之间的硬阈值。
    // Softness 控制过渡带宽度（标准 0.05，脸部可用 0.12 更柔）。
    float ToonRamp(float ShadowStep, float NdotL, float Softness)
    {
        return smoothstep(ShadowStep - Softness, ShadowStep + Softness, NdotL);
    }

    // 标准 toon 阴影合成：以"不含光强的方向响应 DirLight"亮度做 ramp（光强不改变阴影位置），
    // 对齐原版逐灯 NdotL 的口径），再混阴影色。
    // 返回阴影漫反射；ShadedSpecular 输出"门控到受光面"的高光。
    float3 ApplyToonShadow(float3 Diffuse, float3 DirLight, float3 Specular,
                           float ShadowStep, float3 ShadowColor, float Softness,
                           out float3 ShadedSpecular)
    {
        float LightAmount = saturate(dot(DirLight, float3(0.299, 0.587, 0.114)));
        float Ramp        = ToonRamp(ShadowStep, LightAmount, Softness);
        ShadedSpecular = Specular * Ramp;
        return lerp(ShadowColor, float3(1, 1, 1), Ramp) * Diffuse;
    }

    // 从 LightDataMap 找最强的"方向性"主光源（directional/spot/point 取最强者）。
    // 返回世界空间光方向（指向光源），找不到时返回 (1, 0, 0) 兜底。
    // 用于面部 SDF 阴影——需要单一主光向来确定脸阴影分布。
    float3 GetMainLightDirection(Texture2D LightDataMap, SamplerState LightDataMapSampler)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;

        float3 BestDir = float3(1, 0, 0);
        float  BestWeight = -1.0;

        // 注意：这里没法知道 WorldPos（不是基于像素的函数），所以对点光/聚光只能用方向近似。
        //       不带距离衰减；做"找最强主光"已经够用了——脸 SDF 阴影主要看角度。
        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float Weight = C.w;   // 用强度做权重（点光/聚光加距离衰减会更准，但这里没像素位置）
                if (Weight > BestWeight)
                {
                    BestWeight = Weight;
                    // D 是光指向的方向，取负 = 光源方向（点光/聚光/平行光/矩形光口径一致）
                    BestDir = normalize(-D.xyz + float3(1e-5, 1e-5, 1e-5));
                }
            }
        }
        return BestDir;
    }

    // 主光完整数据（方向 + 颜色×强度/PI），口径与 ComputeLighting 一致。
    // 用于脸部 SDF 的漫反射——脸明暗完全由 SDF 贴图 + 头朝向决定，光色直接从
    // LightDataMap 取，**不依赖表面法线 NdotL**，所以法线平面化的脸（MMD 常见）
    // 转动、侧光也不会发黑。
    // 输出：MainLightDirWS 指向光源；MainLightColor 已含强度/PI，可直接当漫反射系数乘。
    void GetMainLightData(Texture2D LightDataMap, SamplerState LightDataMapSampler,
                          out float3 MainLightDirWS, out float3 MainLightColor)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;
        static const float ToonPI    = 3.14159265;

        MainLightDirWS = float3(1, 0, 0);
        MainLightColor = float3(0, 0, 0);
        float BestWeight = -1.0;

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float Weight = C.w;
                if (Weight > BestWeight)
                {
                    BestWeight  = Weight;
                    MainLightDirWS = normalize(-D.xyz + float3(1e-5, 1e-5, 1e-5));
                    MainLightColor = C.rgb * (C.w / ToonPI);
                }
            }
        }
    }

    float3 ApplyNormalMap(FMaterialPixelParameters Parameters,
                          Texture2D NormalMap,
                          SamplerState NormalMapSampler,
                          float NormalMapStrength)
    {
        float3 GeoNormal = normalize((float3)Parameters.TangentToWorld[2]);

        if (NormalMapStrength <= 0.01)
            return GeoNormal;

        float2 UV = Parameters.TexCoords[0];
        float3 TangentNormal = Texture2DSample(NormalMap, NormalMapSampler, UV).xyz;

        // BC5 法线解码：RG 到 [-1,1]（只解扰动量 x,y）
        float2 Nxy = TangentNormal.xy * 2.0 - 1.0;

        // 法线强度：缩放扰动量 xy，再重建 z（1=原样 0=纯几何法线）
        Nxy *= NormalMapStrength;
        float3 TNormal = float3(Nxy, sqrt(1.0 - saturate(dot(Nxy, Nxy))));

        // 切线空间 到 世界空间（TangentToWorld 行 = T, B, N）
        float3x3 TBN = (float3x3)Parameters.TangentToWorld;
        return normalize(mul(TNormal, TBN));
    }

    // 标准 MMD sphere/matcap：视图空间查找 + 采样（相机转动时 matcap 跟着转）。
    // 只采样不应用——是用(matcap烘焙阴影)还是加(matcap高光)由各材质自己决定。
    float3 SampleMatcap(float3 WorldNormal, Texture2D MatCap, SamplerState MatCapSampler)
    {
        float3 ViewNormal = mul(WorldNormal, (float3x3)ResolvedView.TranslatedWorldToView);
        float2 MatcapUV = ViewNormal.xy * 0.5 + 0.5;
        return Texture2DSample(MatCap, MatCapSampler, MatcapUV).rgb;
    }

    // 取一盏灯的方向 L 与衰减 Atten（按灯光类型分派）。
    // P=位置/类型  D=方向  T=附加参数（聚光内外角、面光朝向）。
    // 复用自 ComputeLighting 与 TotalLightIntensity，保证口径一致。
    void LightParams(float4 P, float4 D, float4 T, float3 WorldPos,
                     out float3 L, out float Atten)
    {
        Atten = 1.0;

        if (P.w < 1.5)          // 点光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
        }
        else if (P.w < 2.5)     // 聚光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
            Atten *= smoothstep(T.y, T.x, dot(-L, D.xyz));
        }
        else if (P.w < 3.5)     // 平行光
        {
            L = -normalize(D.xyz);
        }
        else                    // 矩形/面光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
            Atten *= smoothstep(0.0, 0.25, dot(L, D.xyz));
        }
    }

    // 光照计算：累加直接光漫反射 + 高光（不含 toon 阴影、不含 sphere、不含天空环境光）。
    // DiffuseLight  = Σ C.rgb * (C.w / PI) * NdotL * Atten    （最终着色用，带光强）
    // DirLight      = Σ C.rgb * NdotL * Atten                  （不含光强，供 toon 阴影 ramp 用）
    // SpecularLight = Σ C.rgb * (C.w / PI) * pow(NdotH, SpecularPower) * Atten
    void ComputeLighting(FMaterialPixelParameters Parameters,
                         Texture2D LightDataMap,
                         SamplerState LightDataMapSampler,
                         float SpecularPower,
                         float3 WorldNormal,
                         float3 ViewDir,
                         out float3 DiffuseLight,
                         out float3 DirLight,
                         out float3 SpecularLight)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;   // MaxLights * 4
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);

        DiffuseLight  = float3(0, 0, 0);
        DirLight      = float3(0, 0, 0);
        SpecularLight = float3(0, 0, 0);

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);

                float NdotL = saturate(dot(WorldNormal, L));
                DiffuseLight += C.rgb * (C.w / ToonPI) * NdotL * Atten;
                DirLight     += C.rgb * NdotL * Atten;   // 不含光强：光强不改变 toon 阴影位置

                // 高光：颜色用灯光色，锐度由 SpecularPower 控制（阴影门控交给各 usf）。
                float3 H     = normalize(L + ViewDir);
                float  NdotH = saturate(dot(WorldNormal, H));
                float  Spec  = pow(NdotH, max(SpecularPower, 1.0));
                SpecularLight += C.rgb * (C.w / ToonPI) * Spec * Atten;
            }
        }
    }

    // 二次元锐利高光（toon specular）：逐灯 NdotH 硬阶，与 ComputeLighting 的软高光(pow)互补。
    // 软高光给材质"光泽"，锐高光给二次元"湿亮/点光"的块状高光。
    // SpecStep=阈值(建议 0.7~0.9) SpecSoftness=过渡带(建议 0.03~0.08) Intensity=倍率。
    float3 ToonSpecularLight(FMaterialPixelParameters Parameters,
                             Texture2D LightDataMap, SamplerState LightDataMapSampler,
                             float3 WorldNormal, float3 ViewDir,
                             float SpecStep, float SpecSoftness, float Intensity)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 Acc = float3(0, 0, 0);

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);

                float3 H     = normalize(L + ViewDir);
                float  NdotH = saturate(dot(WorldNormal, H));
                float  Step  = smoothstep(SpecStep, SpecStep + SpecSoftness, NdotH);
                Acc += C.rgb * (C.w / ToonPI) * Step * Atten * Intensity;
            }
        }
        return Acc;
    }

    // 天空环境光：与 PBR 相同的 SH 公式，完全跟随 PBR 的天空环境光。
    float3 SkyAmbient(float3 WorldNormal)
    {
        float4 NrmV = float4(WorldNormal, 1.0);
        float3 I0 = float3(dot(View.SkyIrradianceEnvironmentMap[0], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[1], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[2], NrmV));
        float4 VB = NrmV.xyzz * NrmV.yzzx;
        float3 I1 = float3(dot(View.SkyIrradianceEnvironmentMap[3], VB),
                           dot(View.SkyIrradianceEnvironmentMap[4], VB),
                           dot(View.SkyIrradianceEnvironmentMap[5], VB));
        float  VC  = NrmV.x * NrmV.x - NrmV.y * NrmV.y;
        return max(float3(0, 0, 0), I0 + I1 + View.SkyIrradianceEnvironmentMap[6].xyz * VC);
    }

    // 总光强（不含天空）：累加每盏灯 C.w / PI * Atten，口径与 ComputeLighting 一致。
    // 用于给 Rim/自发光等后处理跟随场景实际光照强弱（光弱/背光时自动变弱）。
    float TotalLightIntensity(FMaterialPixelParameters Parameters,
                              Texture2D LightDataMap,
                              SamplerState LightDataMapSampler)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;   // MaxLights * 4
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);

        float Total = 0.0;
        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataMap, LightDataMapSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);
                Total += C.w / ToonPI * Atten;
            }
        }
        return Total;
    }
};

