// MMDToonLighting.ush
//
// Toon 光照工具库（struct TMMDToonLight）：
//   光照计算：ComputeLighting 累加原始漫反�?高光（不含阴�?sphere/天空）；
//   标准法线贴图：ApplyNormalMap（BC5 解码 RG、强度缩�?xy 再重�?z）；
//   标准 toon 阴影：ToonRamp / ApplyToonShadow（软硬度参数化，标准 0.05、脸�?0.12）；
//   标准 sphere/matcap：SampleMatcap（只采样，乘/加由材质自己决定）；
//   SkyAmbient / TotalLightIntensity�?
// 每个材质 usf 声明自己�?struct，include 本文件后组合这些函数；需要特化（�?eye）就自己写�?
// 不调用标准函数。Custom 节点内不能定义独立函数，�?struct �?类型声明"、函数体内合法，
// 所以用 struct 包装。纯插件实现，不改引擎、不�?#define�?
//
// 用法（每个材�?usf 里）�?
//   #include "/Plugin/Ue5MMDTools/Core/MMDToonLighting.ush"
//   TMMDToonLight TL;
//   float3 WorldNormal = TL.ApplyNormalMap(Parameters, NormalMap, NormalMapSampler, NormalMapStrength);
//   float3 Diffuse, DirLight, Specular;
//   TL.ComputeLighting(Parameters, LightDataTex, LightDataTexSampler, SpecularPower,
//                      WorldNormal, ViewDir, Diffuse, DirLight, Specular);
//   float3 ShadedSpecular;
//   float3 ShadedDiffuse = TL.ApplyToonShadow(Diffuse, DirLight, Specular, ShadowStep, ShadowColor, 0.05, ShadedSpecular);
//   float3 Matcap = TL.SampleMatcap(WorldNormal, MatCap, MatCapSampler);
//   // ... 组合�?Final，加 Rim 等特化，最�?return�?
//
// 光照累计�?ADDITIVE：每盏灯贡献 (color * intensity / PI) * NdotL * attenuation�?
// 除以 PI 让响应强度接�?PBR（默认强�?~3.14 的平行光 �?1.0）�?
struct TMMDToonLight
{
    // 取一盏灯的方�?L 与衰�?Atten（按灯光类型分派）�?
    // P=位置/类型  D=方向  T=附加参数（聚光内外角、面光朝向）�?
    // 复用�?ComputeLighting �?TotalLightIntensity，保证口径一致�?
    void LightParams(float4 P, float4 D, float4 T, float3 WorldPos,
                     out float3 L, out float Atten)
    {
        Atten = 1.0;

        if (P.w < 1.5)          // 点光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
        }
        else if (P.w < 2.5)     // 聚光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
            Atten *= smoothstep(T.y, T.x, dot(-L, D.xyz));
        }
        else if (P.w < 3.5)     // 平行�?
        {
            L = -normalize(D.xyz);
        }
        else                    // 矩形/面光
        {
            float3 ToLight = P.xyz - WorldPos;
            float  Dist    = length(ToLight);
            L = ToLight / max(Dist, 0.0001);
            Atten = 1.0 - saturate(Dist / max(D.w, 0.001));
            Atten *= smoothstep(0.0, 0.25, dot(L, D.xyz));
        }
    }

    // toon 阴影 ramp：阴影与受光之间的硬阈值�?
    // Softness 控制过渡带宽度（标准 0.05，脸部可�?0.12 更柔）�?
    float ToonRamp(float ShadowStep, float NdotL, float Softness)
    {
        return smoothstep(ShadowStep - Softness, ShadowStep + Softness, NdotL);
    }

    // 标准 toon 阴影合成：以"不含光强的方向响�?DirLight"亮度�?ramp（光强不改变阴影位置�?
    // 对齐原版逐灯 NdotL 的口径），再混阴影色�?
    // 返回阴影漫反射；ShadedSpecular 输出"门控到受光面"的高光�?
    float3 ApplyToonShadow(float3 Diffuse, float3 DirLight, float3 Specular,
                           float ShadowStep, float3 ShadowColor, float Softness,
                           out float3 ShadedSpecular)
    {
        float LightAmount = saturate(dot(DirLight, float3(0.299, 0.587, 0.114)));
        float Ramp        = ToonRamp(ShadowStep, LightAmount, Softness);
        ShadedSpecular = Specular * Ramp;
        return lerp(ShadowColor, float3(1, 1, 1), Ramp) * Diffuse;
    }

    // 光照计算：累加直接光漫反�?+ 高光（不�?toon 阴影、不�?sphere、不含天空环境光）�?
    // DiffuseLight  = Σ C.rgb * (C.w / PI) * NdotL * Atten    （最终着色用，带光强�?
    // DirLight      = Σ C.rgb * NdotL * Atten                  （不含光强，�?toon 阴影 ramp 用）
    // SpecularLight = Σ C.rgb * (C.w / PI) * pow(NdotH, SpecularPower) * Atten
    void ComputeLighting(FMaterialPixelParameters Parameters,
                         Texture2D LightDataTex,
                         SamplerState LightDataTexSampler,
                         float SpecularPower,
                         float3 WorldNormal,
                         float3 ViewDir,
                         out float3 DiffuseLight,
                         out float3 DirLight,
                         out float3 SpecularLight)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;   // MaxLights * 4
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);

        DiffuseLight  = float3(0, 0, 0);
        DirLight      = float3(0, 0, 0);
        SpecularLight = float3(0, 0, 0);

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);

                float NdotL = saturate(dot(WorldNormal, L));
                DiffuseLight += C.rgb * (C.w / ToonPI) * NdotL * Atten;
                DirLight     += C.rgb * NdotL * Atten;   // 不含光强：光强不改变 toon 阴影位置

                // 高光：颜色用灯光色，锐度�?SpecularPower 控制（阴影门控交给各 usf�?
                float3 H     = normalize(L + ViewDir);
                float  NdotH = saturate(dot(WorldNormal, H));
                float  Spec  = pow(NdotH, max(SpecularPower, 1.0));
                SpecularLight += C.rgb * (C.w / ToonPI) * Spec * Atten;
            }
        }
    }

    // 二次元锐利高光（toon specular）：逐灯 NdotH 硬阶，与 ComputeLighting 的软高光(pow)互补。
    // 软高光给材质"光泽"，锐高光给二次元"湿亮/点光"的块状高光。
    // SpecStep=阈值(建议 0.7~0.9) SpecSoftness=过渡带(建议 0.03~0.08) Intensity=倍率。
    float3 ToonSpecularLight(FMaterialPixelParameters Parameters,
                             Texture2D LightDataTex, SamplerState LightDataTexSampler,
                             float3 WorldNormal, float3 ViewDir,
                             float SpecStep, float SpecSoftness, float Intensity)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 Acc = float3(0, 0, 0);

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);

                float3 H     = normalize(L + ViewDir);
                float  NdotH = saturate(dot(WorldNormal, H));
                float  Step  = smoothstep(SpecStep, SpecStep + SpecSoftness, NdotH);
                Acc += C.rgb * (C.w / ToonPI) * Step * Atten * Intensity;
            }
        }
        return Acc;
    }

    // 天空环境光：与 PBR 相同的 SH 公式，完全跟随 PBR 的天空环境光。
    float3 SkyAmbient(float3 WorldNormal)
    {
        float4 NrmV = float4(WorldNormal, 1.0);
        float3 I0 = float3(dot(View.SkyIrradianceEnvironmentMap[0], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[1], NrmV),
                           dot(View.SkyIrradianceEnvironmentMap[2], NrmV));
        float4 VB = NrmV.xyzz * NrmV.yzzx;
        float3 I1 = float3(dot(View.SkyIrradianceEnvironmentMap[3], VB),
                           dot(View.SkyIrradianceEnvironmentMap[4], VB),
                           dot(View.SkyIrradianceEnvironmentMap[5], VB));
        float  VC  = NrmV.x * NrmV.x - NrmV.y * NrmV.y;
        return max(float3(0, 0, 0), I0 + I1 + View.SkyIrradianceEnvironmentMap[6].xyz * VC);
    }

    // �?LightDataTex 找最强的"方向�?主光源（directional/spot/point 取最强者）�?
    // 返回世界空间光方向（指向光源），找不到时返回 (1, 0, 0) 兜底�?
    // 用于面部 SDF 阴影——需要单一主光向来确定脸阴影分布�?
    float3 GetMainLightDirection(Texture2D LightDataTex, SamplerState LightDataTexSampler)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;

        float3 BestDir = float3(1, 0, 0);
        float  BestWeight = -1.0;

        // 注意：这里没法知�?WorldPos（不是基于像素的函数），所以对点光/聚光只能用方向近�?
        //       不带距离衰减；做"找最强主�?已经够用了——脸 SDF 阴影主要看角度�?
        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float Weight = C.w;   // 用强度做权重（点�?聚光加距离衰减会更准，但这里没像素位置）
                if (Weight > BestWeight)
                {
                    BestWeight = Weight;
                    // D 是光指向的方向，取负 = 光源方向（点�?聚光/平行�?矩形光口径一致）
                    BestDir = normalize(-D.xyz + float3(1e-5, 1e-5, 1e-5));
                }
            }
        }
        return BestDir;
    }

    // 主光完整数据（方�?+ 颜色×强度/PI），口径�?ComputeLighting 一致�?
    // 用于脸部 SDF 的漫反射——脸明暗完全�?SDF 贴图 + 头朝向决定，光色直接�?
    // LightDataTex 取，**不依赖表面法�?NdotL**，所以法线平面化的脸（MMD 常见�?
    // 转动、侧光也不会发黑�?
    // 输出：MainLightDirWS 指向光源；MainLightColor 已含强度/PI，可直接当漫反射系数乘�?
    void GetMainLightData(Texture2D LightDataTex, SamplerState LightDataTexSampler,
                          out float3 MainLightDirWS, out float3 MainLightColor)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;
        static const float ToonPI    = 3.14159265;

        MainLightDirWS = float3(1, 0, 0);
        MainLightColor = float3(0, 0, 0);
        float BestWeight = -1.0;

        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float Weight = C.w;
                if (Weight > BestWeight)
                {
                    BestWeight  = Weight;
                    MainLightDirWS = normalize(-D.xyz + float3(1e-5, 1e-5, 1e-5));
                    MainLightColor = C.rgb * (C.w / ToonPI);
                }
            }
        }
    }

    float3 ApplyNormalMap(FMaterialPixelParameters Parameters,
                          Texture2D NormalMap,
                          SamplerState NormalMapSampler,
                          float NormalMapStrength)
    {
        float3 GeoNormal = normalize((float3)Parameters.TangentToWorld[2]);

        if (NormalMapStrength <= 0.01)
            return GeoNormal;

        float2 UV = Parameters.TexCoords[0];
        float3 TangentNormal = Texture2DSample(NormalMap, NormalMapSampler, UV).xyz;

        // BC5 法线解码：RG �?[-1,1]（只解扰动量 x,y�?
        float2 Nxy = TangentNormal.xy * 2.0 - 1.0;

        // 法线强度：缩放扰动量 xy，再重建 z�?=原样�?=纯几何法线）
        Nxy *= NormalMapStrength;
        float3 TNormal = float3(Nxy, sqrt(1.0 - saturate(dot(Nxy, Nxy))));

        // 切线空间 �?世界空间（TangentToWorld �?= T, B, N�?
        float3x3 TBN = (float3x3)Parameters.TangentToWorld;
        return normalize(mul(TNormal, TBN));
    }

    // 标准 MMD sphere/matcap：视图空间查�?+ 采样（相机转动时 matcap 跟着转）�?
    // 只采样不应用——是�?matcap烘焙阴影)还是�?matcap高光)由各材质自己决定�?
    float3 SampleMatcap(float3 WorldNormal, Texture2D MatCap, SamplerState MatCapSampler)
    {
        float3 ViewNormal = mul(WorldNormal, (float3x3)ResolvedView.TranslatedWorldToView);
        float2 MatcapUV = ViewNormal.xy * 0.5 + 0.5;
        return Texture2DSample(MatCap, MatCapSampler, MatcapUV).rgb;
    }

    // 总光强（不含天空）：累加每盏�?C.w / PI * Atten，口径与 ComputeLighting 一致�?
    // 用于�?Rim/自发光等后处理跟随场景实际光照强弱（光弱/背光时自动变弱）�?
    float TotalLightIntensity(FMaterialPixelParameters Parameters,
                              Texture2D LightDataTex,
                              SamplerState LightDataTexSampler)
    {
        static const int   MaxLights = 16;
        static const float TexWidth  = 64.0;   // MaxLights * 4
        static const float ToonPI    = 3.14159265;

        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);

        float Total = 0.0;
        for (int i = 0; i < MaxLights; i++)
        {
            float4 P = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 0.5) / TexWidth, 0.25));
            float4 C = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 1.5) / TexWidth, 0.25));
            float4 D = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 2.5) / TexWidth, 0.25));
            float4 T = Texture2DSample(LightDataTex, LightDataTexSampler, float2((i * 4.0 + 3.5) / TexWidth, 0.25));

            if (P.w >= 0.5)
            {
                float3 L;
                float  Atten;
                LightParams(P, D, T, WorldPos, L, Atten);
                Total += C.w / ToonPI * Atten;
            }
        }
        return Total;
    }

    // 场景阴影（主平行光遮挡）：把世界坐标投影到阴影相机空间，采样阴影深度 RT 比较。
    // 阴影相机基存在 LightDataTex 第 2 行（y=1，RGBA32F）：
    //   texel0 = (Origin.xyz, Valid)   Origin=阴影相机世界位置；Valid=1 有效（否则返回 1 不受影）
    //   texel1 = (Right/OrthoWidth, GlobalBias)
    //   texel2 = (Up/OrthoWidth, 0)
    //   texel3 = (Forward.xyz, TexelSize)  前轴（光方向），沿它存线性深度（cm）；TexelSize=1/阴影RT分辨率
    // ShadowMap 由 SCS_SceneDepth 捕获的 RGBA16F RT：R 通道 = 沿光轴的线性深度（cm）。
    // 返回阴影因子 [0,1]，1=受光 0=被场景遮挡（4-tap PCF 软边）。
    // 兜底：数据无效（Valid<0.5）-> 返回 1，不影响原有 toon 光照。
    // 默认启用——临时关闭阴影请调用 UMMDShadowMapSubsystem::SetShadowEnabled(false)，
    // 相机基会被写成 Valid=0（见 UMMDShadowMapSubsystem::UpdateShadowForFrame）。
    float SampleMMDShadow(FMaterialPixelParameters Parameters,
                          Texture2D LightDataTex,
                          SamplerState LightDataTexSampler,
                          Texture2D ShadowMap,
                          SamplerState ShadowMapSampler,
                          float ShadowBias)
    {
        static const float TexWidth = 64.0;

        // ---- 读阴影相机基（第 2 行，UV y=0.75）----
        float4 Data0 = Texture2DSample(LightDataTex, LightDataTexSampler, float2(0.5 / TexWidth, 0.75));
        if (Data0.w < 0.5)
            return 1.0;
        float4 Data1 = Texture2DSample(LightDataTex, LightDataTexSampler, float2(1.5 / TexWidth, 0.75));
        float4 Data2 = Texture2DSample(LightDataTex, LightDataTexSampler, float2(2.5 / TexWidth, 0.75));
        float4 Data3 = Texture2DSample(LightDataTex, LightDataTexSampler, float2(3.5 / TexWidth, 0.75));
        float Texel = Data3.w;

        // ---- 世界坐标 -> 阴影空间 ----
        const float3 WorldPos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 ToPix = WorldPos - Data0.xyz;
        float2 UV = float2(dot(ToPix, Data1.xyz) + 0.5, 0.5 - dot(ToPix, Data2.xyz));

        // 出阴影覆盖范围按受光处理（避免硬裁边�?
        if (UV.x < 0.0 || UV.x > 1.0 || UV.y < 0.0 || UV.y > 1.0)
            return 1.0;

        // 沿光轴的像素深度（与 SCS_SceneDepth 的线性深度同口径，cm�?
        float PixelDepth = dot(ToPix, Data3.xyz);
        float Bias = Data1.w + ShadowBias;

        // ---- 4-tap PCF 软阴�?----
        float Shadow = 0.0;
        float2 Offsets[4] = { float2(-0.5, -0.5), float2(0.5, -0.5), float2(-0.5, 0.5), float2(0.5, 0.5) };
        [unroll]
        for (int i = 0; i < 4; i++)
        {
            float2 TapUV = UV + Offsets[i] * Texel;
            float Stored = Texture2DSampleLevel(ShadowMap, ShadowMapSampler, TapUV, 0).r;
            Shadow += (Stored + Bias >= PixelDepth) ? 1.0 : 0.0;
        }
        return Shadow * 0.25;
    }
};
