#pragma once

#include "/Plugin/Ue5MMDTools/Core/TMMDEndfieldNativeLightCapture.ush"

// 在桌面 Clustered 的 DeferredLightingCommon、SubstrateEvaluation 与 SubstrateDeferredLighting 之后 include。
// 传统 GBuffer 的 Clustered 只处理局部补光；不传新脸部 payload，也不重复叠加主光暗底。
#if SUBSTRATE_ENABLED
struct TMMDEndfieldNativeLegacy
{
#if !SHADING_PATH_MOBILE
    FDirectLighting EvaluateLegacy(FGBufferData gbuffer, float3 N, float3 V,
        FAreaLight area_light, FShadowTerms shadow_terms,
        TMMDEndfieldNativeLightData native_light_data)
    {
        FDirectLighting result = ToonBxDF(gbuffer, N, V, area_light, shadow_terms);
        if (!native_light_data.valid) return result;

        float2 pattern_uv = 0.0;
        float profile_id = 0.0;
        UnpackToonCustomData(PackRGBA8(gbuffer.CustomData), pattern_uv, profile_id);
        TMMDEndfieldNativeBSDF profile_control;
        uint role;
        if (!profile_control.IsEndfieldProfile(profile_id, role)) return result;
        uint response_mode = uint(profile_control.ReadProfileControls(profile_id).x);
        if (response_mode == 0u) return result;

        if (response_mode == 1u)
        {
            float3 shadow_channels = saturate(float3(shadow_terms.SurfaceShadow,
                shadow_terms.TransmissionShadow, shadow_terms.TransmittanceOrOpticalThickness));
            result.Diffuse = area_light.Falloff * area_light.FalloffColor * Diffuse_Lambert(shadow_channels);
            result.Specular = 0.0;
            result.Transmission = 0.0;
            return result;
        }
        // 32x8 RS tile 至少需要 256 个独立 texel；所有 Mode2 分类统一防御，Mode0/1 保持原行为。
        if (uint(View.ToonProfileTextureSizeAndInvSize.x) < 256u) return result;

        float surface_shadow = saturate(shadow_terms.SurfaceShadow);
        // Generic 等分类也只增加受光面；阴影和大面余弦各乘一次，外层仍负责灯颜色与强度。
        result.Diffuse = area_light.Falloff * area_light.FalloffColor
            * Diffuse_Lambert(gbuffer.DiffuseColor * 0.96)
            * saturate(area_light.NoL) * surface_shadow;
        float3 source_normal = profile_control.SafeNormalize(N, float3(0.0, 0.0, 1.0));
        float3 specular_normal = role == 2u ? profile_control.HairSpecularNormal(source_normal, V) : source_normal;
        FSubstrateBSDFContext context = (FSubstrateBSDFContext)0;
        context.mmd_light_data = native_light_data;
        context.N = specular_normal;
        context.V = V;
        context.L = native_light_data.light_vector;
        float3x3 tangent_basis = GetTangentBasis(specular_normal);
        context.X = tangent_basis[0];
        TOON_BASECOLOR(context.BSDF) = gbuffer.BaseColor;
        TOON_ROUGHNESS(context.BSDF) = gbuffer.Roughness;
        TOON_METALLIC(context.BSDF) = gbuffer.Metallic;
        TOON_SPECULAR(context.BSDF) = gbuffer.Specular;
        TOON_PROFILEID(context.BSDF) = profile_id;
        TMMDEndfieldSkinResponse skin_response;
        skin_response.Load(profile_id, role, 2u);
        if (role == 1u)
        {
            float3 diffuse_albedo = gbuffer.DiffuseColor * 0.96;
            float band = skin_response.RednessBand(dot(source_normal, native_light_data.light_vector),
                skin_response.redness_width);
            float3 diffuse_color = skin_response.ApplyRedness(diffuse_albedo, diffuse_albedo, band,
                saturate(dot(source_normal, V)), surface_shadow);
            result.Diffuse = area_light.Falloff * area_light.FalloffColor
                * Diffuse_Lambert(diffuse_color) * saturate(area_light.NoL) * surface_shadow;
        }
        if (native_light_data.rect_light)
        {
            // 矩形光不能把二维 RS tile 当原生一维颜色 ramp；用真实面积与 F0 的 LTC 物理兜底。
            // LTC 已积分光源余弦，不再追加 NoL；保留矩形灯原始几何法线。
            result.Specular = surface_shadow * area_light.Falloff * area_light.FalloffColor
                * RectGGXApproxLTC(clamp(gbuffer.Roughness, 0.04, 1.0), gbuffer.SpecularColor,
                    1.0, source_normal, V, area_light.Rect, area_light.Texture);
        }
        else if (role == 1u || role == 2u || role == 3u)
        {
            float specular_cosine = role == 2u ? 1.0 : saturate(area_light.NoL);
            result.Specular = surface_shadow * specular_cosine * area_light.Falloff * area_light.FalloffColor
                * profile_control.EvaluateSpecular(context, specular_normal, role, source_normal, skin_response.valid);
        }
        // 其它分类保留 ToonBxDF 的原生高光；外层不再重复相乘 SurfaceShadow。
        result.Transmission = 0.0;
        return result;
    }
#endif

    float4 EvaluateDynamicLighting(float3 translated_world_position, float3 camera_vector,
        FGBufferData gbuffer, float ambient_occlusion, FDeferredLightData light_data,
        float4 light_attenuation, float dither, uint2 pixel_coord,
        inout float surface_shadow)
    {
#if SHADING_PATH_MOBILE
        return GetDynamicLighting(translated_world_position, camera_vector, gbuffer, ambient_occlusion,
            light_data, light_attenuation, dither, pixel_coord, surface_shadow);
#else
        // 保留原调用及其分光、阴影和诊断行为，默认模式不能重新拼装原生结果。
        if (gbuffer.ShadingModelID != SHADINGMODELID_SUBSTRATE_TOON)
            return GetDynamicLighting(translated_world_position, camera_vector, gbuffer, ambient_occlusion,
                light_data, light_attenuation, dither, pixel_coord, surface_shadow);

        float2 pattern_uv = 0.0;
        float profile_id = 0.0;
        UnpackToonCustomData(PackRGBA8(gbuffer.CustomData), pattern_uv, profile_id);
        TMMDEndfieldNativeBSDF profile_control;
        uint role;
        if (!profile_control.IsEndfieldProfile(profile_id, role))
            return GetDynamicLighting(translated_world_position, camera_vector, gbuffer, ambient_occlusion,
                light_data, light_attenuation, dither, pixel_coord, surface_shadow);
        uint response_mode = uint(profile_control.ReadProfileControls(profile_id).x);
        if (response_mode == 0u)
            return GetDynamicLighting(translated_world_position, camera_vector, gbuffer, ambient_occlusion,
                light_data, light_attenuation, dither, pixel_coord, surface_shadow);
        if (response_mode == 2u && uint(View.ToonProfileTextureSizeAndInvSize.x) < 256u)
            return GetDynamicLighting(translated_world_position, camera_vector, gbuffer, ambient_occlusion,
                light_data, light_attenuation, dither, pixel_coord, surface_shadow);

        FLightAccumulator accumulator = (FLightAccumulator)0;
        float3 V = -camera_vector;
        float3 N = gbuffer.WorldNormal;
        float3 L = light_data.Direction;
        float3 to_light = L;
        float light_mask = 1.0;
        if (light_data.bRadialLight)
            light_mask = GetLocalLightAttenuation(translated_world_position, light_data, to_light, L);
        accumulator.EstimatedCost = 0.3;
        if (light_mask > 0.0)
        {
            FShadowTerms shadow_terms = (FShadowTerms)0;
            shadow_terms.SurfaceShadow = ambient_occlusion;
            shadow_terms.TransmissionShadow = 1.0;
            shadow_terms.TransmittanceOrOpticalThickness = 1.0;
            shadow_terms.HairTransmittance = light_data.HairTransmittance;
            GetShadowTerms(gbuffer.Depth, gbuffer.PrecomputedShadowFactors, gbuffer.ShadingModelID,
                gbuffer.CustomData.a, light_data, translated_world_position, L,
                light_attenuation, dither, shadow_terms);
            surface_shadow = shadow_terms.SurfaceShadow;
            accumulator.EstimatedCost += 0.3;
            if (shadow_terms.SurfaceShadow + shadow_terms.TransmissionShadow > 0.0)
            {
                FAreaLight area_light = InitAreaLight();
                if (light_data.bRectLight)
                {
                    FRect rect = GetRect(to_light, light_data);
                    if (!IsRectVisible(rect)) return 0.0;
                    FRectTexture source_texture = ConvertToRectTexture(light_data);
                    area_light = CreateAreaLight(gbuffer.Roughness, N, V, rect, source_texture);
                }
                else
                {
                    FCapsuleLight capsule = GetCapsule(to_light, light_data);
                    area_light = CreateAreaLight(gbuffer.Roughness, N, V, capsule, light_data.bInverseSquared);
                }

                TMMDEndfieldNativeLightCapture capture;
                TMMDEndfieldNativeLightData native_light_data = capture.Build(light_data, L, to_light,
                    light_mask, light_attenuation, gbuffer.PrecomputedShadowFactors,
                    translated_world_position, gbuffer.Depth, dither, true, false);
                FDirectLighting lighting = EvaluateLegacy(gbuffer, N, V, area_light,
                    shadow_terms, native_light_data);
                lighting.Diffuse *= light_data.DiffuseScale;
                lighting.Specular *= light_data.SpecularScale;
                float3 masked_light_color = light_data.Color * light_mask;
#if USE_LIGHT_FUNCTION_ATLAS
                masked_light_color *= GetLocalLightFunctionCommon(translated_world_position,
                    light_data.LightFunctionAtlasLightIndex);
#endif
                bool separate_subsurface = UseSubsurfaceProfile(gbuffer.ShadingModelID);
                LightAccumulator_AddSplit(accumulator, lighting.Diffuse, lighting.Specular,
                    lighting.Diffuse, masked_light_color, separate_subsurface);
                accumulator.EstimatedCost += 0.4;
            }
        }
        FDeferredLightingSplit split_lighting = LightAccumulator_GetResultSplit(accumulator);
        return split_lighting.SpecularLighting + split_lighting.DiffuseLighting;
#endif
    }
};
#endif
