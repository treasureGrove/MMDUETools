#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ToonProfileCommon.ush"

RWByteAddressBuffer mmd_protocol_output;

#if defined(TMMD_ENDFIELD_COOKED_BACKEND_PROTOCOL) && TMMD_ENDFIELD_COOKED_BACKEND_PROTOCOL == 13
uint mmd_endfield_cooked_protocol_13;
#endif

[numthreads(1, 1, 1)]
void MainCS(uint3 dispatch_thread_id : SV_DispatchThreadID)
{
	uint protocol = 0u;
#if defined(TMMD_ENDFIELD_COOKED_BACKEND_PROTOCOL) && TMMD_ENDFIELD_COOKED_BACKEND_PROTOCOL == 13
	// 参数真实参与可观察输出，不能只声明后依赖可能被优化移除的反射。
	protocol = mmd_endfield_cooked_protocol_13;
#endif
	mmd_protocol_output.Store(dispatch_thread_id.x * 4u, protocol);
}
