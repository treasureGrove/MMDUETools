#ifndef MMD_ANIME_ENVIRONMENT_USF
#define MMD_ANIME_ENVIRONMENT_USF

// ============================================================================
// TAnimeEnvironment
// Environment / light-probe utilities for MMD anime-style rendering.
// Reads from UE5 ResolvedView atmosphere data for main light & ambient.
// ============================================================================

struct TAnimeEnvironment
{
    // ------------------------------------------------------------------------
    // Get main directional light direction from the atmosphere system.
    // Falls back to straight-up (0,1,0) if no atmosphere light is available.
    //   returns : unit vector pointing toward the main light
    // ------------------------------------------------------------------------
    float3 GetMainLightDirection()
    {
        float3 dir = ResolvedView.AtmosphereLightDirection[0].xyz;
        float len = length(dir);
        return (len > 0.001) ? normalize(dir) : float3(0.0, 1.0, 0.0);
    }

    // ------------------------------------------------------------------------
    // Get main directional light color (post-transmittance illuminance).
    //   returns : linear RGB light color (HDR)
    // ------------------------------------------------------------------------
    float3 GetMainLightColor()
    {
        return ResolvedView.AtmosphereLightIlluminanceOnGroundPostTransmittance[0].rgb;
    }

    // ------------------------------------------------------------------------
    // Get scalar luminance of the main light.
    //   returns : perceptual intensity [0..+]
    // ------------------------------------------------------------------------
    float GetMainLightIntensity()
    {
        float3 color = GetMainLightColor();
        return dot(color, float3(0.2126, 0.7152, 0.0722));
    }

    // ------------------------------------------------------------------------
    // Simple hemisphere ambient: upper hemisphere is sky, lower is ground.
    //   normal : surface normal (unit)
    //   returns: ambient color approximation (sky blue above, warm below)
    // ------------------------------------------------------------------------
    float3 GetAmbientColor(float3 normal)
    {
        float3 skyColor = float3(0.45, 0.55, 0.75);
        float3 groundColor = float3(0.35, 0.30, 0.25);
        float hemiFactor = saturate(normal.z * 0.5 + 0.5); // world-up bias
        return lerp(groundColor, skyColor, hemiFactor);
    }

    // ------------------------------------------------------------------------
    // Mix ambient color into shadow tint for environment-aware shadows.
    //   normal   : surface normal (unit)
    //   strength : blend strength [0..1], default 0.3
    //   returns  : environment tint color
    // ------------------------------------------------------------------------
    float3 GetEnvironmentTint(float3 normal, float strength)
    {
        float3 ambient = GetAmbientColor(normal);
        return lerp(float3(1.0, 1.0, 1.0), ambient, strength);
    }

    // ------------------------------------------------------------------------
    // Simplified global illumination approximation.
    // Blends hemisphere ambient with a flat fill based on surface orientation.
    //   normal         : surface normal (unit)
    //   ambientStrength: how much ambient contributes [0..1], default 0.3
    //   returns        : GI color contribution
    // ------------------------------------------------------------------------
    float3 ComputeGIResponse(float3 normal, float ambientStrength)
    {
        float3 ambient = GetAmbientColor(normal);
        float3 fillLight = float3(0.3, 0.3, 0.35); // neutral fill
        float upFactor = saturate(normal.z * 0.5 + 0.5);
        float3 gi = lerp(fillLight, ambient, upFactor);
        return gi * ambientStrength;
    }
};

#endif
