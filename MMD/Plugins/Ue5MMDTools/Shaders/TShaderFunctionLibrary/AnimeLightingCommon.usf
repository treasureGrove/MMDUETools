#ifndef MMD_ANIME_LIGHTING_COMMON_USF
#define MMD_ANIME_LIGHTING_COMMON_USF

// ============================================================================
// TAnimeLightingCommon
// Core lighting utility functions for MMD anime-style rendering.
// Used by material-level .ush shaders via Custom HLSL nodes.
// ============================================================================

struct TAnimeLightingCommon
{
    // ------------------------------------------------------------------------
    // Get scalar intensity from an HDR light color (luminance).
    //   lightColor : linear RGB light color (any range)
    //   returns    : perceptual scalar intensity [0..+]
    // ------------------------------------------------------------------------
    float NormalizeLightIntensity(float3 lightColor)
    {
        return dot(lightColor, float3(0.2126, 0.7152, 0.0722));
    }

    // ------------------------------------------------------------------------
    // Extract pure tint (normalized hue) from light color.
    //   lightColor : linear RGB light color
    //   returns    : unit-brightness tint, falls back to white for black light
    // ------------------------------------------------------------------------
    float3 NormalizeLightColor(float3 lightColor)
    {
        float intensity = NormalizeLightIntensity(lightColor);
        return (intensity > 0.001) ? (lightColor / intensity) : float3(1.0, 1.0, 1.0);
    }

    // ------------------------------------------------------------------------
    // Remap a value from one range to another.
    //   value        : input value [inMin..inMax]
    //   inMin, inMax : source range
    //   outMin, outMax : target range
    //   returns      : remapped value (unclamped)
    // ------------------------------------------------------------------------
    float RemapRange(float value, float inMin, float inMax, float outMin, float outMax)
    {
        float t = (value - inMin) / max(inMax - inMin, 0.0001);
        return lerp(outMin, outMax, t);
    }

    // ------------------------------------------------------------------------
    // Controllable soft threshold (centered smoothstep).
    //   value    : input value [0..1]
    //   edge     : threshold center [0..1], default 0.5
    //   softness : transition width [0..1], default 0.05
    //   returns  : 0 below edge-softness, 1 above edge+softness
    // ------------------------------------------------------------------------
    float SoftStep(float value, float edge, float softness)
    {
        float lo = edge - softness;
        float hi = edge + softness;
        return smoothstep(lo, hi, value);
    }

    // ------------------------------------------------------------------------
    // Basic toon shadow: single-layer hard/soft shadow boundary.
    //   NdotL      : dot(normal, lightDir) [-1..1]
    //   threshold  : shadow cutoff [-1..1], default 0.2
    //   softness   : transition width [0..1], default 0.02
    //   returns    : 0 = fully shadowed, 1 = fully lit
    // ------------------------------------------------------------------------
    float ComputeToonShadow(float NdotL, float threshold, float softness)
    {
        return smoothstep(threshold - softness, threshold + softness, NdotL);
    }

    // ------------------------------------------------------------------------
    // Dual-layer toon shadow for a sculpted anime feel.
    // Layer 1: main shadow boundary at 'threshold'.
    // Layer 2: deeper shadow offset by 'deepOffset' for form emphasis.
    //   NdotL      : dot(normal, lightDir) [-1..1]
    //   threshold  : primary shadow cutoff [-1..1], default 0.2
    //   softness   : transition width [0..1], default 0.02
    //   deepOffset : offset for second darker layer [0..1], default 0.3
    //   returns    : 0 = deep shadow, 0.5 = mid shadow, 1 = fully lit
    // ------------------------------------------------------------------------
    float ComputeDualLayerShadow(float NdotL, float threshold, float softness, float deepOffset)
    {
        float primary = smoothstep(threshold - softness, threshold + softness, NdotL);
        float deep = smoothstep(threshold - deepOffset - softness, threshold - deepOffset + softness, NdotL);
        return (primary + deep) * 0.5;
    }

    // ------------------------------------------------------------------------
    // Fresnel-based rim mask for anime rim lighting.
    //   NdotV      : dot(normal, viewDir) [0..1]
    //   rimWidth   : how wide the rim band is [0..1], default 0.3
    //   rimSoftness: edge softness [0..1], default 0.1
    //   returns    : 0 = no rim, 1 = full rim
    // ------------------------------------------------------------------------
    float ComputeRimMask(float NdotV, float rimWidth, float rimSoftness)
    {
        float rimBase = 1.0 - NdotV;
        float edge = 1.0 - rimWidth;
        return smoothstep(edge - rimSoftness, edge + rimSoftness, rimBase);
    }

    // ------------------------------------------------------------------------
    // Cel-style anime specular highlight.
    //   N        : surface normal (unit)
    //   L        : light direction (unit, toward light)
    //   V        : view direction (unit, toward camera)
    //   size     : specular lobe size [0..1], default 0.5
    //   hardness : edge sharpness [1..64], default 8.0
    //   returns  : specular intensity [0..1]
    // ------------------------------------------------------------------------
    float ComputeAnimeSpecular(float3 N, float3 L, float3 V, float size, float hardness)
    {
        float3 H = normalize(L + V);
        float NdotH = saturate(dot(N, H));
        // Remap size: larger size => lower threshold => bigger highlight
        float threshold = 1.0 - saturate(size);
        float spec = smoothstep(threshold - 0.01, threshold + 0.01, pow(NdotH, hardness));
        return spec;
    }
};

#endif
