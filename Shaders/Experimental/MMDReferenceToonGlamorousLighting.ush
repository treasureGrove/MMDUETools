// MMDReferenceToonGlamorousLighting.ush
// 华丽二次元光照：彩色灯参与表面分层，低饱和材质使用几何冷暖色，不依赖 UV 阈值图。
struct TMMDReferenceToonLight
{
    float Luminance(float3 color)
    {
        return dot(color, float3(0.299, 0.587, 0.114));
    }

    float3 SafeNormalize(float3 value, float3 fallback)
    {
        float length_squared = dot(value, value);
        return length_squared > 0.000001 ? value * rsqrt(length_squared) : fallback;
    }

    float ArtisticIntensity(float artistic_intensity)
    {
        // 非物理艺术强度压缩到稳定范围，避免多灯叠加冲白。
        return 1.0 - exp(-max(artistic_intensity, 0.0));
    }

    void SampleLight(Texture2D light_data_tex, int light_index,
                     out float4 P, out float4 C, out float4 D, out float4 T)
    {
        int base_index = light_index * 4;
        P = light_data_tex.Load(int3(base_index + 0, 0, 0));
        C = light_data_tex.Load(int3(base_index + 1, 0, 0));
        D = light_data_tex.Load(int3(base_index + 2, 0, 0));
        T = light_data_tex.Load(int3(base_index + 3, 0, 0));
    }

    void LightParams(float4 P, float4 D, float4 T, float3 world_pos,
                     out float3 L, out float attenuation)
    {
        L = float3(0.0, 0.0, 1.0);
        attenuation = 0.0;

        if (P.w < 1.5)
        {
            float3 to_light = P.xyz - world_pos;
            float distance_to_light = length(to_light);
            L = SafeNormalize(to_light, L);
            float range_fade = 1.0 - saturate(distance_to_light / max(D.w, 0.001));
            attenuation = range_fade * range_fade;
        }
        else if (P.w < 2.5)
        {
            float3 to_light = P.xyz - world_pos;
            float distance_to_light = length(to_light);
            L = SafeNormalize(to_light, L);
            float range_fade = 1.0 - saturate(distance_to_light / max(D.w, 0.001));
            float cone_fade = smoothstep(T.y, T.x, dot(-L, SafeNormalize(D.xyz, float3(0.0, 0.0, -1.0))));
            attenuation = range_fade * range_fade * cone_fade;
        }
        else if (P.w < 3.5)
        {
            L = -SafeNormalize(D.xyz, float3(0.35, 0.45, -0.82));
            attenuation = 1.0;
        }
        else
        {
            float3 to_light = P.xyz - world_pos;
            float distance_to_light = length(to_light);
            L = SafeNormalize(to_light, L);
            float range_fade = 1.0 - saturate(distance_to_light / max(D.w, 0.001));
            float facing = smoothstep(0.0, 0.25, dot(L, SafeNormalize(D.xyz, float3(0.0, 0.0, -1.0))));
            attenuation = range_fade * range_fade * facing;
        }
    }

    void CollectArtisticLights(FMaterialPixelParameters Parameters,
                               Texture2D light_data_tex,
                               float3 world_normal,
                               float3 view_direction,
                               out float3 key_direction,
                               out float3 key_color,
                               out float key_strength,
                               out float3 direct_color,
                               out float3 stage_accent,
                               out float light_count)
    {
        const float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float best_score = -1.0;
        key_direction = SafeNormalize(float3(-0.35, -0.45, 0.82), float3(0.0, 0.0, 1.0));
        key_color = float3(1.0, 0.94, 0.88);
        key_strength = 0.85;
        direct_color = float3(0.0, 0.0, 0.0);
        stage_accent = float3(0.0, 0.0, 0.0);
        light_count = 0.0;
        float direct_weight = 0.0;

        [unroll]
        for (int i = 0; i < 16; ++i)
        {
            float4 P;
            float4 C;
            float4 D;
            float4 T;
            SampleLight(light_data_tex, i, P, C, D, T);

            if (P.w >= 0.5)
            {
                float3 L;
                float attenuation;
                LightParams(P, D, T, world_pos, L, attenuation);

                float intensity = ArtisticIntensity(C.w);
                float3 bounded_color = max(C.rgb, 0.0);
                float color_luma = max(Luminance(bounded_color), 0.001);
                bounded_color /= max(color_luma, 1.0);
                float color_max = max(max(bounded_color.r, bounded_color.g), bounded_color.b);
                float color_min = min(min(bounded_color.r, bounded_color.g), bounded_color.b);
                float color_chroma = saturate(color_max - color_min);
                float score = intensity * attenuation;
                float n_dot_l = dot(world_normal, L);
                float light_band = smoothstep(-0.18, 0.08, n_dot_l);
                float wrapped_band = smoothstep(-0.62, -0.08, n_dot_l);
                float surface_weight = 0.06 + wrapped_band * 0.24 + light_band * 0.70;
                float directional_priority = (P.w >= 2.5 && P.w < 3.5) ? 1.18 : 1.0;
                float key_facing = 0.12 + 0.88 * saturate(n_dot_l * 0.5 + 0.5);
                float key_score = score * directional_priority * key_facing;
                float edge_weight = pow(saturate(1.0 - dot(world_normal, view_direction)), 1.6);
                float backlight_weight = saturate((0.20 - n_dot_l) * 0.9);

                // 有色灯优先进入表面色调，中性主光只负责稳定造型，不再冲淡霓虹颜色。
                float chroma_weight = 0.16 + color_chroma * 3.20;
                direct_color += bounded_color * score * surface_weight * chroma_weight;
                direct_weight += score * surface_weight * chroma_weight;
                stage_accent += bounded_color * score * edge_weight *
                                (0.12 + 0.88 * backlight_weight) *
                                (0.20 + color_chroma * 2.40);
                light_count += step(0.001, score);

                if (key_score > best_score)
                {
                    best_score = key_score;
                    key_direction = L;
                    key_color = bounded_color;
                    key_strength = score;
                }
            }
        }

        if (light_count > 0.5)
        {
            direct_color /= max(direct_weight, 0.001);
            direct_color = 1.0 - exp(-direct_color * 1.65);
            stage_accent = 1.0 - exp(-stage_accent * 1.35);
            // 将 light_count 复用为表面有效直射光权重，背向灯不再稀释主光。
            light_count = 1.0 - exp(-direct_weight * 2.2);
        }
        else
        {
            // LightDataRT 未写入时仍给出完整、可读的通用 toon。
            direct_color = float3(0.48, 0.54, 0.64);
            float fallback_edge = pow(saturate(1.0 - dot(world_normal, view_direction)), 2.0);
            stage_accent = float3(0.12, 0.32, 0.50) * fallback_edge;
        }
    }

    float3 SkyAmbient(float3 world_normal)
    {
        float4 normal_vector = float4(world_normal, 1.0);
        float3 linear_term = float3(
            dot(View.SkyIrradianceEnvironmentMap[0], normal_vector),
            dot(View.SkyIrradianceEnvironmentMap[1], normal_vector),
            dot(View.SkyIrradianceEnvironmentMap[2], normal_vector));
        float4 quadratic_vector = normal_vector.xyzz * normal_vector.yzzx;
        float3 quadratic_term = float3(
            dot(View.SkyIrradianceEnvironmentMap[3], quadratic_vector),
            dot(View.SkyIrradianceEnvironmentMap[4], quadratic_vector),
            dot(View.SkyIrradianceEnvironmentMap[5], quadratic_vector));
        float final_term = normal_vector.x * normal_vector.x - normal_vector.y * normal_vector.y;
        return max(float3(0.0, 0.0, 0.0),
                   linear_term + quadratic_term + View.SkyIrradianceEnvironmentMap[6].xyz * final_term);
    }

    float ShadowCompareBilinear(Texture2D mmd_shadow_map, int cascade_index,
                                float2 local_uv, float pixel_depth, float bias)
    {
        uint atlas_width;
        uint atlas_height;
        mmd_shadow_map.GetDimensions(atlas_width, atlas_height);
        int cascade_resolution = max((int)atlas_width / 2, 1);
        int2 cascade_offset = int2((cascade_index & 1) * cascade_resolution,
                                   (cascade_index >> 1) * cascade_resolution);

        float2 texel_position = local_uv * cascade_resolution - 0.5;
        int2 base_texel = int2(floor(texel_position));
        float2 blend = frac(texel_position);
        int2 max_texel = int2(cascade_resolution - 1, cascade_resolution - 1);
        int2 p00 = min(max(base_texel, int2(0, 0)), max_texel);
        int2 p10 = min(p00 + int2(1, 0), max_texel);
        int2 p01 = min(p00 + int2(0, 1), max_texel);
        int2 p11 = min(p00 + int2(1, 1), max_texel);

        float c00 = step(pixel_depth, mmd_shadow_map.Load(int3(cascade_offset + p00, 0)).r + bias);
        float c10 = step(pixel_depth, mmd_shadow_map.Load(int3(cascade_offset + p10, 0)).r + bias);
        float c01 = step(pixel_depth, mmd_shadow_map.Load(int3(cascade_offset + p01, 0)).r + bias);
        float c11 = step(pixel_depth, mmd_shadow_map.Load(int3(cascade_offset + p11, 0)).r + bias);
        return lerp(lerp(c00, c10, blend.x), lerp(c01, c11, blend.x), blend.y);
    }

    void SampleShadowCascade(Texture2D mmd_shadow_map, int cascade_index,
                             float3 world_pos, float3 world_normal,
                             float4 data_0, float4 data_1, float4 data_2, float4 data_3,
                             float additional_bias, out float shadow, out float valid)
    {
        shadow = 1.0;
        valid = 0.0;
        if (data_0.w <= 0.0)
            return;

        uint atlas_width;
        uint atlas_height;
        mmd_shadow_map.GetDimensions(atlas_width, atlas_height);
        float cascade_resolution = max((float)atlas_width * 0.5, 1.0);

        float3 light_direction = -SafeNormalize(data_3.xyz, float3(0.0, 0.0, -1.0));
        float n_dot_l = saturate(dot(world_normal, light_direction));
        float3 biased_world_pos = world_pos + world_normal * data_2.w * (1.0 - n_dot_l);
        float3 to_pixel = biased_world_pos - data_0.xyz;
        float2 local_uv = float2(dot(to_pixel, data_1.xyz) + 0.5,
                                 0.5 - dot(to_pixel, data_2.xyz));
        float pixel_depth = dot(to_pixel, data_3.xyz);

        float border = 2.5 / cascade_resolution;
        if (local_uv.x < border || local_uv.x > 1.0 - border ||
            local_uv.y < border || local_uv.y > 1.0 - border ||
            pixel_depth < 0.0 || pixel_depth > data_0.w)
            return;

        static const float2 offsets[5] =
        {
            float2(0.0, 0.0), float2(-1.0, 0.0), float2(1.0, 0.0),
            float2(0.0, -1.0), float2(0.0, 1.0)
        };
        static const float weights[5] = { 4.0, 1.0, 1.0, 1.0, 1.0 };
        float accumulated = 0.0;
        [unroll]
        for (int tap_index = 0; tap_index < 5; ++tap_index)
        {
            float2 tap_uv = local_uv + offsets[tap_index] * (1.15 / cascade_resolution);
            accumulated += ShadowCompareBilinear(mmd_shadow_map, cascade_index, tap_uv,
                                                 pixel_depth, data_1.w + additional_bias) * weights[tap_index];
        }
        shadow = accumulated * 0.125;
        valid = 1.0;
    }

    float SampleSceneShadow(FMaterialPixelParameters Parameters,
                            Texture2D light_data_tex,
                            Texture2D mmd_shadow_map,
                            float additional_bias)
    {
        float4 camera_position = light_data_tex.Load(int3(16, 1, 0));
        float4 camera_forward = light_data_tex.Load(int3(17, 1, 0));
        if (camera_forward.w < 0.5)
            return 1.0;

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = SafeNormalize((float3)Parameters.TangentToWorld[2], float3(0.0, 0.0, 1.0));
        float view_distance = max(dot(world_pos - camera_position.xyz, camera_forward.xyz), 0.0);

        [unroll]
        for (int cascade_index = 0; cascade_index < 4; ++cascade_index)
        {
            int base_index = cascade_index * 4;
            float4 data_0 = light_data_tex.Load(int3(base_index + 0, 1, 0));
            float4 data_1 = light_data_tex.Load(int3(base_index + 1, 1, 0));
            float4 data_2 = light_data_tex.Load(int3(base_index + 2, 1, 0));
            float4 data_3 = light_data_tex.Load(int3(base_index + 3, 1, 0));
            if (view_distance > data_3.w && cascade_index < 3)
                continue;

            float shadow;
            float valid;
            SampleShadowCascade(mmd_shadow_map, cascade_index, world_pos, world_normal,
                                data_0, data_1, data_2, data_3, additional_bias, shadow, valid);
            if (valid > 0.5)
                return shadow;
        }
        return 1.0;
    }

    float3 Shade(FMaterialPixelParameters Parameters,
                 float3 base_color,
                 Texture2D light_data_tex,
                 Texture2D mmd_shadow_map,
                 float shadow_threshold,
                 float shadow_softness,
                 float midtone_width,
                 float shadow_strength,
                 float ambient_strength,
                 float light_saturation,
                 float scene_shadow_strength,
                 float mmd_shadow_bias,
                 float specular_threshold,
                 float specular_strength,
                 float rim_power,
                 float rim_strength,
                 float3 rim_color,
                 float anisotropy_strength)
    {
        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = SafeNormalize((float3)Parameters.TangentToWorld[2], float3(0.0, 0.0, 1.0));
        float3 world_tangent = SafeNormalize((float3)Parameters.TangentToWorld[0], float3(1.0, 0.0, 0.0));
        float3 view_direction = SafeNormalize(LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
                                              float3(0.0, 0.0, 1.0));

        float3 key_direction;
        float3 key_color;
        float key_strength;
        float3 direct_color;
        float3 stage_accent;
        float light_count;
        CollectArtisticLights(Parameters, light_data_tex, world_normal, view_direction,
                              key_direction, key_color, key_strength, direct_color,
                              stage_accent, light_count);

        float n_dot_l = dot(world_normal, key_direction);
        float softness = max(shadow_softness, 0.001);
        float lit_mask = smoothstep(shadow_threshold - softness,
                                    shadow_threshold + softness, n_dot_l);
        float mid_threshold = shadow_threshold - max(midtone_width, 0.02);
        float mid_mask = smoothstep(mid_threshold - softness * 1.5,
                                    mid_threshold + softness * 1.5, n_dot_l);

        float key_luma = max(Luminance(key_color), 0.001);
        float3 key_hue = min(key_color / key_luma, 2.0);
        float direct_luma = max(Luminance(direct_color), 0.001);
        float3 direct_hue = min(direct_color / direct_luma, 2.0);
        float base_luma = Luminance(base_color);
        float base_max = max(max(base_color.r, base_color.g), base_color.b);
        float base_min = min(min(base_color.r, base_color.g), base_color.b);
        float base_chroma = saturate(base_max - base_min);
        float neutral_surface = 1.0 - smoothstep(0.05, 0.30, base_chroma);
        float pale_surface = smoothstep(0.035, 0.32, base_luma) * neutral_surface;
        // 皮肤实例用较高 softness，借参数分支而不是模型或 UV 专用遮罩。
        float skin_profile = smoothstep(0.075, 0.12, shadow_softness);
        float cloth_profile = pale_surface * (1.0 - skin_profile);
        float color_amount = saturate(light_saturation * 1.6);
        float direct_presence = saturate(light_count * direct_luma * 3.2);
        float3 surface_light_hue = lerp(float3(1.0, 1.0, 1.0), direct_hue,
                                        color_amount * direct_presence);
        float3 colored_key = lerp(float3(1.0, 1.0, 1.0), key_hue, color_amount);

        float darken = saturate(shadow_strength);
        float stage_luma = max(Luminance(stage_accent), 0.001);
        float3 stage_hue = min(stage_accent / stage_luma, 2.0);
        float3 side_axis = SafeNormalize(cross(key_direction, float3(0.0, 0.0, 1.0)),
                                         float3(1.0, 0.0, 0.0));
        float side_mask = smoothstep(-0.42, 0.58, dot(world_normal, side_axis));
        float3 split_tint = lerp(float3(1.18, 0.62, 1.04),
                                 float3(0.52, 1.12, 1.26), side_mask);

        float3 shadow_tint = lerp(float3(0.52, 0.64, 1.18), stage_hue,
                                  color_amount * saturate(stage_luma * 2.4) * 0.52);
        shadow_tint = lerp(shadow_tint, shadow_tint * split_tint,
                           pale_surface * 0.48);
        float3 cloth_shadow = lerp(float3(0.88, 0.66, 1.02),
                                   float3(0.62, 0.84, 1.08), side_mask);
        float3 skin_shadow = float3(1.02, 0.72, 0.78);
        shadow_tint = lerp(shadow_tint, cloth_shadow, cloth_profile * 0.54);
        shadow_tint = lerp(shadow_tint, skin_shadow, skin_profile * 0.54);
        float3 mid_light_hue = lerp(float3(0.82, 0.96, 1.16), surface_light_hue, 0.66);
        mid_light_hue = lerp(mid_light_hue, colored_key, 0.36);
        mid_light_hue = lerp(mid_light_hue, mid_light_hue * split_tint,
                             pale_surface * 0.38);
        float3 cloth_mid = lerp(float3(1.04, 0.92, 1.04),
                                float3(0.84, 1.00, 1.08), side_mask);
        float3 skin_mid = float3(1.06, 0.92, 0.90);
        mid_light_hue = lerp(mid_light_hue, cloth_mid, cloth_profile * 0.68);
        mid_light_hue = lerp(mid_light_hue, skin_mid, skin_profile * 0.44);
        float3 lit_light_hue = lerp(float3(1.16, 0.90, 1.04), surface_light_hue, 0.70);
        lit_light_hue = lerp(lit_light_hue, colored_key, 0.58);
        lit_light_hue = lerp(lit_light_hue, lit_light_hue * split_tint,
                             pale_surface * 0.30);
        float3 cloth_lit = lerp(float3(1.06, 0.99, 1.01),
                                float3(0.94, 1.02, 1.04), side_mask);
        float3 skin_lit = float3(1.06, 1.00, 0.96);
        lit_light_hue = lerp(lit_light_hue, cloth_lit, cloth_profile * 0.72);
        lit_light_hue = lerp(lit_light_hue, skin_lit, skin_profile * 0.34);
        float3 shadow_tone = base_color * (1.0 - darken * 0.72) * shadow_tint;
        float3 mid_tone = base_color * (1.0 - darken * 0.34) * mid_light_hue;
        float3 lit_tone = base_color * lit_light_hue *
                          (1.00 + 0.10 * saturate(key_strength));
        float cloth_energy = base_luma * cloth_profile;
        shadow_tone += cloth_energy * lerp(float3(0.020, 0.00, 0.045),
                                           float3(0.00, 0.026, 0.052), side_mask);
        mid_tone += cloth_energy * lerp(float3(0.024, 0.00, 0.030),
                                       float3(0.00, 0.030, 0.038), side_mask);

        float3 toon_color = lerp(shadow_tone, mid_tone, mid_mask);
        toon_color = lerp(toon_color, lit_tone, lit_mask);

        float scene_shadow = SampleSceneShadow(Parameters, light_data_tex, mmd_shadow_map, mmd_shadow_bias);
        float shadow_visibility = lerp(1.0, scene_shadow, saturate(scene_shadow_strength));
        toon_color = lerp(shadow_tone, toon_color, shadow_visibility);

        float3 sky_color = SkyAmbient(world_normal) * View.SkyLightColor.rgb;
        float3 ambient_color = max(sky_color, float3(0.10, 0.11, 0.14));
        float ambient_luma = Luminance(ambient_color);
        ambient_color /= max(1.0, ambient_luma);
        toon_color += base_color * ambient_color * max(ambient_strength, 0.0) * 0.55;

        float3 half_vector = SafeNormalize(key_direction + view_direction, view_direction);
        float n_dot_h = saturate(dot(world_normal, half_vector));
        float specular_mask = smoothstep(saturate(specular_threshold),
                                         saturate(specular_threshold) + 0.035, n_dot_h);
        float broad_specular_mask = smoothstep(saturate(specular_threshold - 0.22),
                                               saturate(specular_threshold - 0.08), n_dot_h) *
                                      (1.0 - specular_mask);
        float3 specular_hue = lerp(colored_key, split_tint, pale_surface * 0.30);
        float3 specular = specular_hue *
                          (specular_mask + broad_specular_mask * 0.22) *
                          max(specular_strength, 0.0) * 0.86 * shadow_visibility;

        float tangent_dot_h = dot(world_tangent, half_vector);
        float anisotropic_term = sqrt(saturate(1.0 - tangent_dot_h * tangent_dot_h));
        float anisotropic_mask = smoothstep(0.72, 0.94, anisotropic_term) *
                                 smoothstep(-0.25, 0.45, n_dot_l);
        float anisotropic_core = smoothstep(0.91, 0.985, anisotropic_term);
        specular += specular_hue * (anisotropic_mask * 0.52 + anisotropic_core * 0.64) *
                    max(anisotropy_strength, 0.0) * shadow_visibility;

        float n_dot_v = saturate(dot(world_normal, view_direction));
        float edge_factor = saturate(1.0 - n_dot_v);
        float rim_mask = pow(edge_factor, max(rim_power, 0.1));
        rim_mask *= 0.35 + 0.65 * saturate(1.0 - n_dot_l * 0.5);
        float line_rim = smoothstep(0.48, 0.82, edge_factor);
        float stage_presence = saturate(stage_luma * 2.8);
        float3 cool_rim = lerp(max(rim_color, 0.0), stage_hue, stage_presence * 0.72);
        float3 warm_rim = float3(1.18, 0.30, 0.72);
        float warm_side = smoothstep(0.18, 0.86, edge_factor) * (1.0 - side_mask);
        float3 rim = (cool_rim * (rim_mask * 1.10 + line_rim * side_mask * 0.46) +
                      warm_rim * line_rim * warm_side * 0.34 +
                      stage_accent * (rim_mask * 0.58 + line_rim * 0.34)) *
                     max(rim_strength, 0.0);

        return min(max(toon_color + specular + rim, 0.0), 1.35);
    }
};
