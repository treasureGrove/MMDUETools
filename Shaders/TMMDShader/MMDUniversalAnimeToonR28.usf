// R28 几何分层：强化肤色、白布三段色、黑缎折面和场景双色辉光。
#include "/Plugin/Ue5MMDTools/TMMDShader/MMDUniversalAnimeToonImplementationR25.usf"

struct TMMDUniversalAnimeToonR28
{
    float3 RefineColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_tex_sampler,
                       float shadow_step,
                       float shadow_softness,
                       float shadow_strength,
                       float ambient_strength,
                       float light_color_influence,
                       float highlight_step,
                       float highlight_strength,
                       float rim_strength,
                       float rim_power,
                       float local_light_strength,
                       float local_specular_strength,
                       float glamour_rim_strength,
                       float directional_sheen_strength,
                       float surface_profile,
                       float3 base_texture_color,
                       float3 diffuse_color)
    {
        TMMDUniversalAnimeToonR25 base_toon;
        float3 shaded_color = base_toon.OutputColor(
            Parameters,
            base_color,
            light_data_tex,
            light_data_tex_sampler,
            shadow_step,
            shadow_softness,
            shadow_strength,
            ambient_strength,
            light_color_influence,
            highlight_step,
            highlight_strength,
            rim_strength,
            rim_power,
            local_light_strength,
            local_specular_strength,
            glamour_rim_strength,
            directional_sheen_strength,
            surface_profile,
            base_texture_color,
            diffuse_color
        );

        float profile_skin = 1.0 - step(0.5, abs(surface_profile - 1.0));
        float profile_hair = 1.0 - step(0.5, abs(surface_profile - 2.0));
        float profile_white_cloth = 1.0 - step(0.5, abs(surface_profile - 3.0));
        float profile_black_satin = 1.0 - step(0.5, abs(surface_profile - 4.0));

        float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        float3 world_normal = base_toon.SafeNormalize((float3)Parameters.TangentToWorld[2],
                                                      float3(0.0, 0.0, 1.0));
        float3 view_direction = base_toon.SafeNormalize(
            LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos,
            float3(0.0, 0.0, 1.0));

        float3 key_direction;
        float3 key_color;
        float key_energy;
        float3 scene_light_color;
        float scene_light_energy;
        base_toon.FindPrimaryLight(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            key_direction,
            key_color,
            key_energy,
            scene_light_color,
            scene_light_energy
        );
        if (key_energy < 0.0)
        {
            key_direction = base_toon.SafeNormalize(
                view_direction + float3(-0.62, 0.0, 0.38),
                view_direction
            );
        }

        float n_dot_l = dot(world_normal, key_direction);
        float n_dot_v = saturate(dot(world_normal, view_direction));
        float silhouette = saturate(1.0 - n_dot_v);
        float mid_band = smoothstep(-0.26, 0.02, n_dot_l);
        float lit_band = smoothstep(0.22, 0.48, n_dot_l);

        float diffuse_max = max(max(diffuse_color.r, diffuse_color.g), diffuse_color.b);
        float3 safe_diffuse = diffuse_max > 0.001 ? max(diffuse_color, 0.0) :
                              float3(1.0, 1.0, 1.0);
        float3 source_color = max(base_texture_color, 0.0) * safe_diffuse;

        float3 skin_shadow = source_color * float3(1.05, 0.79, 0.80) +
                             float3(0.030, 0.006, 0.008);
        float3 skin_mid = source_color * float3(1.12, 0.91, 0.90) +
                          float3(0.060, 0.018, 0.018);
        float3 skin_lit = source_color * float3(1.18, 0.98, 0.95) +
                          float3(0.090, 0.030, 0.025);
        float3 skin_layered = lerp(skin_shadow, skin_mid, mid_band);
        skin_layered = lerp(skin_layered, skin_lit, lit_band);
        float skin_side = smoothstep(0.20, 0.62, silhouette) *
                          (1.0 - smoothstep(0.84, 0.98, silhouette));
        skin_layered += float3(0.045, 0.006, 0.012) * skin_side;
        shaded_color = lerp(shaded_color, skin_layered, profile_skin * 0.80);

        float3 white_shadow = source_color * float3(0.68, 0.73, 0.84) +
                              float3(0.006, 0.009, 0.018);
        float3 white_mid = source_color * float3(0.90, 0.93, 0.99) +
                           float3(0.010, 0.012, 0.020);
        float3 white_lit = source_color * float3(1.08, 1.08, 1.10) +
                           float3(0.018, 0.019, 0.026);
        float3 white_layered = lerp(white_shadow, white_mid, mid_band);
        white_layered = lerp(white_layered, white_lit, lit_band);
        float white_fold_edge = smoothstep(0.34, 0.72, silhouette) *
                                (1.0 - smoothstep(0.86, 0.98, silhouette));
        white_layered *= 1.0 - white_fold_edge * 0.10;
        shaded_color = lerp(shaded_color, white_layered, profile_white_cloth * 0.82);

        float black_mid_band = smoothstep(-0.34, 0.04, n_dot_l);
        float black_lit_band = smoothstep(0.24, 0.56, n_dot_l);
        float3 black_shadow = float3(0.016, 0.020, 0.030) + source_color * 0.13;
        float3 black_mid = float3(0.082, 0.094, 0.125) + source_color * 0.20;
        float3 black_lit = float3(0.205, 0.215, 0.255) + source_color * 0.24;
        float3 black_layered = lerp(black_shadow, black_mid, black_mid_band);
        black_layered = lerp(black_layered, black_lit, black_lit_band);
        float black_inner_ink = smoothstep(0.78, 0.965, silhouette);
        black_layered *= 1.0 - black_inner_ink * 0.34;
        shaded_color = lerp(shaded_color, black_layered, profile_black_satin * 0.88);

        float3 unused_diffuse;
        float3 unused_specular;
        float3 extra_local_rim;
        base_toon.ComputeLocalLights(
            light_data_tex,
            light_data_tex_sampler,
            world_pos,
            world_normal,
            view_direction,
            highlight_step,
            rim_power,
            light_color_influence,
            0.0,
            0.0,
            glamour_rim_strength * 1.45,
            unused_diffuse,
            unused_specular,
            extra_local_rim
        );
        float rim_profile_gain = 0.52 + profile_hair * 0.24 +
                                 profile_white_cloth * 0.10 +
                                 profile_black_satin * 0.28 -
                                 profile_skin * 0.10;
        shaded_color += extra_local_rim * rim_profile_gain;

        return min(max(shaded_color, 0.0), 2.20);
    }
};

TMMDUniversalAnimeToonR28 universal_anime_toon;
return universal_anime_toon.RefineColor(
    Parameters,
    base_color,
    light_data_tex,
    light_data_texSampler,
    shadow_step,
    shadow_softness,
    shadow_strength,
    ambient_strength,
    light_color_influence,
    highlight_step,
    highlight_strength,
    rim_strength,
    rim_power,
    local_light_strength,
    local_specular_strength,
    glamour_rim_strength,
    directional_sheen_strength,
    surface_profile,
    base_texture_color,
    diffuse_color
);
