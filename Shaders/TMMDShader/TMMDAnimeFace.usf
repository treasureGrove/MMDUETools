// TMMDAnimeFace.usf
//
// 面部材质（单独处理）：声明自己的 struct，调用 Core/MMDToonLighting.ush 拿原始光照。
// 与基础材质相比，脸部阴影更柔、阴影更浅（脸不能太黑），边缘光更明显（面部轮廓发光），
// 高光更收敛（鼻梁/额头一点柔光，避免脸油）。
// 完全通用：只依赖 base_color + light_data_tex + 法线，不依赖任何 UV 布局/配套贴图（见 AGENTS.md 通用性铁律）。
//
// Custom 节点用法（OutputType: float3）：
//   Code:
//     #include "/Plugin/Ue5MMDTools/TMMDShader/TMMDAnimeFace.usf"
//     return 0;   // 兜底返回值（正常不可达）
//
//   节点输入（最少连 base_color + light_data_tex 就能完整着色）：
//     base_color          (float3)    - 面部基础色（base_color × 面部贴图）
//     light_data_tex      (Texture2D) - 灯光数据 RT
//     shadow_step         (float)     - 卡通阴影阈值（脸建议 0.5~0.6）
//     highlight_step      (float)     - 锐高光阈值（<=0 用默认 0.85，脸高光很收敛）
//     shadow_color        (float3)    - 阴影压暗色（建议 0.6~0.7 灰，脸阴影偏浅）
//     specular_power      (float)     - 高光锐度（鼻梁/额头柔光）
//     normal_map          (Texture2D) - 法线贴图（可选；不接或强度 0 用几何法线）
//     normal_map_strength (float)     - 法线强度（0=关 1=满）
//     rim_color           (float3)    - 边缘光颜色（建议偏冷/肤色反光）
//     rim_power           (float)     - 边缘带宽度（越大越窄，建议 2~4）
//     rim_strength        (float)     - 边缘光强度
//
//   节点作用域自动提供：Parameters / light_data_texSampler / normal_mapSampler
#include "/Plugin/Ue5MMDTools/Core/MMDToonLighting.ush"

struct TMMDAnimeFace
{
    float3 OutputColor(FMaterialPixelParameters Parameters,
                       float3 base_color,
                       Texture2D light_data_tex,
                       SamplerState light_data_texSampler,
                       float shadow_step,
                       float highlight_step,
                       float3 shadow_color,
                       float specular_power,
                       Texture2D normal_map,
                       SamplerState normal_mapSampler,
                       float normal_map_strength,
                       float3 rim_color,
                       float rim_power,
                       float rim_strength)
    {
        const float3 world_pos = LWCToFloat(Parameters.AbsoluteWorldPosition);
        const float3 view_dir  = normalize(LWCToFloat(GetWorldCameraOrigin(Parameters)) - world_pos);

        TMMDToonLight tl;
        const float3 world_normal = tl.ApplyNormalMap(Parameters, normal_map, normal_mapSampler, normal_map_strength);

        float3 diffuse, dir_light, specular;
        tl.ComputeLighting(Parameters, light_data_tex, light_data_texSampler, specular_power,
                           world_normal, view_dir, diffuse, dir_light, specular);

        // ---- 受光量 ----
        const float3 luma_w = float3(0.299, 0.587, 0.114);
        float light_amount = saturate(dot(dir_light, luma_w));

        // ---- 脸部阴影：更柔（softness 0.15）、更浅（向 base_color 抬升，脸不能黑）----
        const float softness = 0.15;
        float ramp = smoothstep(shadow_step - softness, shadow_step + softness, light_amount);

        float3 shadow_tone = base_color * saturate(shadow_color);
        // 脸部阴影抬升：明暗交界不会像硬表面那么黑，保持肤色通透
        shadow_tone = shadow_tone + base_color * 0.12;

        float3 lit_tone    = base_color * diffuse;
        float3 shaded_diffuse = lerp(shadow_tone, lit_tone, ramp);

        // ---- 天空环境光：阴影区压到 55%（脸比硬表面更亮）----
        float3 sky_light = tl.SkyAmbient(world_normal) * View.SkyLightColor.rgb;
        shaded_diffuse += base_color * sky_light * lerp(0.55, 1.0, ramp);

        // ---- 高光：软高光（收敛，脸别油）+ 极收敛锐高光 ----
        float3 shaded_specular = specular * ramp * 0.5;
        float  spec_step = highlight_step > 0.01 ? highlight_step : 0.85;
        float3 toon_spec = tl.ToonSpecularLight(Parameters, light_data_tex, light_data_texSampler,
                                                world_normal, view_dir, spec_step, 0.04, 0.8);
        toon_spec *= ramp;

        float3 final = shaded_diffuse + shaded_specular + toon_spec;

        // ---- Rim（边缘光，跟随光强；脸轮廓发光是二次元脸关键）----
        float light_intensity = saturate(tl.TotalLightIntensity(Parameters, light_data_tex, light_data_texSampler));
        float n_dot_v = saturate(dot(world_normal, view_dir));
        float rim     = pow(1.0 - n_dot_v, max(rim_power, 0.5));
        final += rim_color * rim_strength * rim * light_intensity;

        return final;
    }
};

TMMDAnimeFace face;
return face.OutputColor(Parameters,
                        base_color, light_data_tex, light_data_texSampler,
                        shadow_step, highlight_step, shadow_color,
                        specular_power,
                        normal_map, normal_mapSampler, normal_map_strength,
                        rim_color, rim_power, rim_strength);
