#!/bin/sh
# 推送前拦截：Markdown 里的相对链接必须能解析，且大小写与仓库一致。
# 起因：README 写 Docs/（或反过来）时，Windows 本地完全看不出来，线上整页裂图。
#
# 启用：pwsh -File Scripts/Install-GitHooks.ps1（发布树）
#       pwsh -File MMD/Plugins/Ue5MMDTools/Scripts/Install-GitHooks.ps1（开发树）
# 临时跳过：git push --no-verify

if ! command -v pwsh >/dev/null 2>&1; then
    echo "跳过 Markdown 链接检查：未找到 pwsh"
    exit 0
fi

script=""
for candidate in Scripts/Test-MarkdownLinks.ps1 MMD/Plugins/Ue5MMDTools/Scripts/Test-MarkdownLinks.ps1; do
    if [ -f "$candidate" ]; then
        script="$candidate"
        break
    fi
done

if [ -z "$script" ]; then
    echo "跳过 Markdown 链接检查：未找到 Test-MarkdownLinks.ps1"
    exit 0
fi

pwsh -NoProfile -File "$script" -Root .